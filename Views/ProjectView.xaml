<UserControl x:Class="NoCodeVision.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ProjectItemTemplate">
            <DockPanel LastChildFill="True">
                <ctrl:AppleIconTile Glyph="📁" TileSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProjectName}" Style="{StaticResource AppleLabel}" />
            </DockPanel>
        </DataTemplate>

        <!-- 紧凑行：标签固定宽度，控件紧随其后（与相机页一致） -->
        <Style x:Key="CompactRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="10,1" />
        </Style>
        <Style x:Key="CompactLabel" TargetType="TextBlock" BasedOn="{StaticResource AppleLabel}">
            <Setter Property="Width" Value="92" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CompactInput" TargetType="TextBox" BasedOn="{StaticResource AppleTextField}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CompactCombo" TargetType="ComboBox" BasedOn="{StaticResource AppleComboBox}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="140" />
        </Style>
        <!-- 分块卡片：横向平铺用，固定宽度、紧凑边距（与相机页 BlockCard 一致） -->
        <Style x:Key="BlockCard" TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
            <Setter Property="Width" Value="440" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ctrl:AppleMasterList Grid.Column="0" Header="项目列表" HeaderIcon="📁"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              AddCommand="{Binding AddCmd}"
                              DeleteCommand="{Binding DeleteCmd}"
                              ItemTemplate="{StaticResource ProjectItemTemplate}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,8">

                <TextBlock Style="{StaticResource iOSTitle}" Text="项目" />

                <!-- 分块布局：各参数组作为卡片横向平铺、自动换行（与相机页一致） -->
                <WrapPanel Orientation="Horizontal">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="基本信息" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="项目名称" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="负责人" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.Author, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="客户名称" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.Customer, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="标签" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.Tags, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="项目描述" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" VerticalContentAlignment="Top" Padding="0,6" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 版本与日期 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="版本与日期" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="项目版本" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.ProjectVersion, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="创建时间" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.CreateTime}" IsReadOnly="True" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="修改时间" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.ModifyTime, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 路径 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="路径" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="项目路径" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.ProjectPath}" IsReadOnly="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 自动保存 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="自动保存" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="启用自动保存" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.AutoSave}" HorizontalAlignment="Left" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="保存间隔" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.SaveInterval, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="秒" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 界面与语言 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="界面与语言" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="界面主题" />
                                <ComboBox Grid.Column="1" Style="{StaticResource CompactCombo}"
                                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedProject.Theme}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="默认单位" />
                                <ComboBox Grid.Column="1" Style="{StaticResource CompactCombo}"
                                          ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedProject.DefaultUnit}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="界面语言" Margin="14,8,14,2" />
                            <ListBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedProject.Language}"
                                     Style="{StaticResource ApplePillList}" Margin="10,0,10,12" />
                        </StackPanel>
                    </Border>

                    <!-- 日志 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="日志" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="日志级别" />
                                <ComboBox Grid.Column="1" Style="{StaticResource CompactCombo}"
                                          ItemsSource="{Binding LogLevels}" SelectedItem="{Binding SelectedProject.LogLevel}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="保留天数" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.LogKeepDays, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="天" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 运行 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="运行" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="开机自启动" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.AutoStart}" HorizontalAlignment="Left" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="启动后自动运行" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.AutoRunAfterStart}" HorizontalAlignment="Left" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="异常自动停机" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.EmergencyStopOnError}" HorizontalAlignment="Left" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="调试模式" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.DebugMode}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 存储路径 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="存储路径" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="图像保存路径" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.ImageSavePath, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="数据保存路径" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.DataSavePath, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="备份路径" />
                                <TextBox Grid.Column="1" Style="{StaticResource CompactInput}" Text="{Binding SelectedProject.BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="最大备份数" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.MaxBackupCount, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="个" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="结果保留" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.ResultRetainDays, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="天" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 安全 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="安全" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="启用密码" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.PasswordEnabled}" HorizontalAlignment="Left" />
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="自动锁屏" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="分钟" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="撤销步数" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.MaxUndoSteps, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <TextBlock Style="{StaticResource AppleUnit}" Text="步" />
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource CompactLabel}" Text="允许远程" />
                                <CheckBox Grid.Column="1" Style="{StaticResource AppleToggle}" IsChecked="{Binding SelectedProject.AllowRemote}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 操作 -->
                    <Border Style="{StaticResource BlockCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="操作" />
                            <Grid Style="{StaticResource CompactRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Style="{StaticResource AppleBtnSecondary}" Content="新建" Command="{Binding NewCmd}" />
                                    <Button Style="{StaticResource AppleBtnSecondary}" Content="打开" Command="{Binding OpenCmd}" />
                                    <Button Style="{StaticResource AppleBtn}" Content="保存" Command="{Binding SaveCmd}" />
                                    <Button Style="{StaticResource AppleBtnSecondary}" Content="另存为" Command="{Binding SaveCmd}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Text="{Binding SelectedProject.Status}" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
