<UserControl x:Class="NoCodeVision.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ProjectItemTemplate">
            <DockPanel LastChildFill="True">
                <ctrl:AppleIconTile Glyph="📁" TileSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProjectName}" Style="{StaticResource AppleLabel}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ctrl:AppleMasterList Grid.Column="0" Header="项目列表" HeaderIcon="📁"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              AddCommand="{Binding AddCmd}"
                              DeleteCommand="{Binding DeleteCmd}"
                              ItemTemplate="{StaticResource ProjectItemTemplate}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,8">

                <TextBlock Style="{StaticResource iOSTitle}" Text="项目" />

                <!-- 项目信息 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="项目信息" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="项目名称" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="负责人" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.Author, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="创建时间" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.CreateTime}" IsReadOnly="True" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="项目路径" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.ProjectPath}" IsReadOnly="True" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 工程设置 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="工程设置" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="自动保存" />
                            <CheckBox Style="{StaticResource AppleToggle}" DockPanel.Dock="Right" IsChecked="{Binding SelectedProject.AutoSave}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="保存间隔" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedProject.SaveInterval, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <TextBlock Style="{StaticResource AppleUnit}" Text="秒" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="14,10,14,6" Text="界面语言" />
                        <ListBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedProject.Language}"
                                 Style="{StaticResource ApplePillList}" Margin="10,0,10,12" />
                    </StackPanel>
                </Border>

                <!-- 操作 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="操作" />
                        <DockPanel Style="{StaticResource AppleRow}" LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="新建" Command="{Binding NewCmd}" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="打开" Command="{Binding OpenCmd}" />
                                <Button Style="{StaticResource AppleBtn}" Content="保存" Command="{Binding SaveCmd}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Text="{Binding SelectedProject.Status}" Foreground="{StaticResource AccentBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
