<UserControl x:Class="NoCodeVision.Views.MultiChannelMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
<!-- 温启志：18719361399  混淆: 温m启k志v：c1h8a7n1n9e3l6m1o3n9i9 -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- 通道卡片：紧凑信息展示 -->
        <Style x:Key="ChCard" TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
            <Setter Property="MinWidth" Value="300" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 状态 Pill 颜色切换器 -->
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource AppleStatusPill}">
            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="运行中">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已停止">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 状态文字颜色 -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="运行中">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 指标数值 -->
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource AppleLabel}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource AppleSubLabel}">
            <Setter Property="FontSize" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部栏：标题 + 全局控制 + 布局切换 ===== -->
        <Border Grid.Row="0" Style="{StaticResource AppleGroupCard}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题 + 全局状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="多通道视觉监控" Style="{StaticResource iOSTitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="14,0,0,0" Padding="10,4">
                        <TextBlock Text="{Binding GlobalStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- 右侧：全局操作 + 布局 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 布局切换 -->
                    <Border Background="{StaticResource SegTrackBrush}" CornerRadius="8" Padding="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="2列" Style="{StaticResource SegButton}" Command="{Binding Layout2Cmd}"
                                    MinWidth="40" Padding="8,4" FontSize="11" />
                            <Button Content="3列" Style="{StaticResource SegButtonSelected}" Command="{Binding Layout3Cmd}"
                                    MinWidth="40" Padding="8,4" FontSize="11" x:Name="BtnL3" />
                            <Button Content="4列" Style="{StaticResource SegButton}" Command="{Binding Layout4Cmd}"
                                    MinWidth="40" Padding="8,4" FontSize="11" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource AppleBtn}" Content="全部启动" Command="{Binding StartAllCmd}" Padding="14,6" />
                    <Button Style="{StaticResource AppleBtnSecondary}" Content="全部停止" Command="{Binding StopAllCmd}" Margin="8,0,0,0" Padding="14,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体：通道卡片网格（WrapPanel 自动换行） ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      x:Name="CardScroller">
            <ItemsControl ItemsSource="{Binding Channels}" x:Name="ChannelList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ChCard}"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown"
                                AllowDrop="True" Drop="Card_Drop" DragOver="Card_DragOver"
                                Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="160" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 行 0：通道名 + 状态 Pill -->
                                <DockPanel Grid.Row="0" Margin="10,10,10,4" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource AppleLabel}"
                                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DockPanel>

                                <!-- 行 1：图像预览区 -->
                                <Border Grid.Row="1" Margin="8,2,8,6" Background="{StaticResource PreviewBgBrush}" CornerRadius="10"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Grid>
                                        <!-- 有图时显示图像 -->
                                        <Image Source="{Binding LastImage, Mode=OneWay}" Stretch="Uniform" IsHitTestVisible="False">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastImage}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <!-- 无图时显示占位 -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                                                Background="#1C1C22" Padding="16,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📷" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding CameraId}" Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <!-- 运行中无图时显示动画提示 -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                                                Background="#1A2332" Padding="16,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding LastImage}" Value="{x:Null}" />
                                                                <Condition Binding="{Binding IsRunning}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="● 采集中…" Foreground="{StaticResource AccentBrush}" FontSize="13"
                                                           HorizontalAlignment="Center" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FrameCount, StringFormat='已采集 {0} 帧'}" Foreground="#8E8E93" FontSize="11"
                                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 行 2：三列指标（匹配分 / 缺陷数 / 周期） -->
                                <Grid Grid.Row="2" Margin="10,4,10,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 匹配分数 -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MatchScore, StringFormat={}{0:F2}}" Style="{StaticResource MetricValue}"
                                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="匹配分" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 缺陷数 -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DefectCount}" Style="{StaticResource MetricValue}"
                                                   Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="缺陷数" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 周期时间 -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CycleTime, StringFormat={}{0:F0}ms}" Style="{StaticResource MetricValue}"
                                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="周期" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- 行 3：底部操作栏 -->
                                <DockPanel Grid.Row="3" Margin="10,4,10,10" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CameraId}" Style="{StaticResource AppleSubLabel}"
                                               FontSize="10" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource AppleBtn}" Content="启动" Command="{Binding StartCmd}"
                                                Padding="12,3" FontSize="11" />
                                        <Button Style="{StaticResource AppleBtnSecondary}" Content="停止" Command="{Binding StopCmd}"
                                                Margin="6,0,0,0" Padding="12,3" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== 详情浮层（点击卡片放大查看） ===== -->
        <Grid Grid.RowSpan="2" Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisConverter}}"
              Background="#C0000000" x:Name="DetailOverlay" MouseLeftButtonDown="Overlay_Click">
            <Border Style="{StaticResource AppleGroupCard}" Width="900" Height="640"
                    CornerRadius="16" Background="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="DetailBorder_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 详情标题栏 -->
                    <DockPanel Grid.Row="0" Margin="20,16,20,8" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedChannel.Name}" Style="{StaticResource iOSTitle}"
                                       FontSize="17" VerticalAlignment="Center" />
                            <Border Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedChannel.Status}" Style="{StaticResource StatusText}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AppleBtnSecondary}" Content="✕ 关闭"
                                Command="{Binding CloseDetailCmd}" Padding="12,4" FontSize="12" />
                    </DockPanel>

                    <!-- 详情主体：左大图 + 右指标表格 -->
                    <Grid Grid.Row="1" Margin="20,0,20,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：大图预览 -->
                        <Border Background="{StaticResource PreviewBgBrush}" CornerRadius="12" ClipToBounds="True">
                            <Image Source="{Binding SelectedChannel.LastImage, Mode=OneWay}" Stretch="Uniform">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChannel.LastImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>

                        <!-- 右：完整指标表 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="检测指标" Style="{StaticResource AppleSectionHeader}" Margin="0,0,0,10" />

                            <!-- 指标网格 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="相机 ID" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedChannel.CameraId}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="状态" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedChannel.Status}" Style="{StaticResource StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="连接" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AppleLabel}">
                                            <Setter Property="Text" Value="未连接" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChannel.IsConnected}" Value="True">
                                                    <Setter Property="Text" Value="已连接" />
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="匹配分数" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedChannel.MatchScore, StringFormat={}{0:F4}}" Style="{StaticResource MetricValue}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="缺陷数量" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedChannel.DefectCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="周期耗时" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedChannel.CycleTime, StringFormat={}{0:F1} ms}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="采集帧数" Style="{StaticResource AppleSubLabel}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedChannel.FrameCount}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 操作按钮区 -->
                            <Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <Button Style="{StaticResource AppleBtn}" Content="▶ 启动采集"
                                            Command="{Binding SelectedChannel.StartCmd}" Margin="0,0,0,8" Padding="14,6" HorizontalAlignment="Stretch" />
                                    <Button Style="{StaticResource AppleBtnSecondary}" Content="■ 停止采集"
                                            Command="{Binding SelectedChannel.StopCmd}" Padding="14,6" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 底部提示 -->
                    <TextBlock Grid.Row="2" Text="点击遮罩区域关闭详情 · 拖拽卡片可调整顺序"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,10" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
