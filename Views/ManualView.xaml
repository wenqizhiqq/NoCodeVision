                        <TextBlock Style="{StaticResource ManualItemBody}" Text="• 同一台电脑上的流程、工程数量不限，操作员界面数量不限。" />
                    </StackPanel>
                    <Rectangle Style="{StaticResource AppleDivider}" />

                    <StackPanel Style="{StaticResource ManualItem}">
                        <TextBlock Style="{StaticResource ManualItemTitle}" Text="8.4 购买流程（一步一步来）" />
                    </StackPanel>
                    <Grid Margin="16,0,16,10">
