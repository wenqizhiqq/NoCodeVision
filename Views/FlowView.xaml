<UserControl x:Class="NoCodeVision.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             xmlns:local="clr-namespace:NoCodeVision"
             mc:Ignorable="d">

    <UserControl.Resources>
        <local:IntToBoolConverter x:Key="IntToBoolConverter" />

        <DataTemplate x:Key="FlowItemTemplate">
            <DockPanel LastChildFill="True" Margin="0,2,0,2">
                <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Steps.Count, StringFormat='{}{0} 步'}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" Margin="0,0,12,0" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="StepItemTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="83" />
                    <ColumnDefinition Width="101" />
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="87" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.LogicRelations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding LogicRelation, FallbackValue='如果'}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="22" />
                    <TextBlock Text="{Binding Function}" Style="{StaticResource AppleLabel}" Margin="8,0,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="2" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding StatusText, FallbackValue='未开始'}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <ComboBox Grid.Column="3" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Operator, FallbackValue='大于'}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBox Grid.Column="4" Text="{Binding InputValue, FallbackValue=''}" Style="{StaticResource AppleTextFieldInline}"
                         TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Grid.Column="5" Text="{Binding CostMs, StringFormat='{}{0:F1}'}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程方案列表 -->
        <ctrl:AppleMasterList Grid.Column="0" Header="流程方案" HeaderIcon="🔀"
                              ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}"
                              AddCommand="{Binding AddFlowCmd}" DeleteCommand="{Binding DeleteFlowCmd}"
                              ItemTemplate="{StaticResource FlowItemTemplate}" />

        <!-- 中间：流程步骤 -->
        <Grid Grid.Column="1" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource iOSTitle}" Text="{Binding SelectedFlow.Name, FallbackValue='流程'}" />

            <!-- 工具栏（新建步骤 + 操作按钮，紧凑单行） -->
            <Border Grid.Row="1" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource AppleComboBox}" Width="150" VerticalAlignment="Center"
                              ItemsSource="{Binding StepFunctions}" SelectedItem="{Binding NewStepFunction}" />
                    <Button Style="{StaticResource AppleBtn}" Content="➕ 添加" Command="{Binding AddStepCmd}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🗑 删除" Command="{Binding DeleteStepCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬆️ 上移" Command="{Binding MoveUpCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬇️ 下移" Command="{Binding MoveDownCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🧹 清空" Command="{Binding ClearCmd}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 步骤列表 -->
            <Border Grid.Row="2" Style="{StaticResource AppleGroupCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Height="36" Background="{StaticResource HoverBrush}" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="83" />
                        <ColumnDefinition Width="101" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="87" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="逻辑" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                        <TextBlock Grid.Column="1" Text="功能" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                        <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                        <TextBlock Grid.Column="3" Text="运算" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                        <TextBlock Grid.Column="4" Text="输入值" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                        <TextBlock Grid.Column="5" Text="耗时" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" FontWeight="SemiBold" Height="14" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFlow.Steps}" SelectedItem="{Binding SelectedStep}"
                             Style="{StaticResource AppleListBox}" ItemTemplate="{StaticResource StepItemTemplate}">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppleListBoxItem}">
                                <Setter Property="Padding" Value="0,11,0,11" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 底部调试工具栏：单步运行 / 全部运行 -->
            <Border Grid.Row="3" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AppleBtn}" Content="▶ 单步运行" Command="{Binding StepRunCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleBtn}" Content="▶▶ 全部运行" Command="{Binding RunCmd}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右侧：步骤属性（按步骤类型动态切换） -->
        <ScrollViewer Grid.Column="2" Margin="16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource iOSTitle}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} - {1}">
                            <Binding Path="SelectedStep.Function" FallbackValue="步骤属性" />
                            <Binding Path="SelectedStep.Name" FallbackValue="" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- ========== 图像采集 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="ImageCapture">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="相机参数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像源" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageSource, FallbackValue=''}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="曝光(us)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="8000" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="增益" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="10" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="采集方式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedStep.CaptureMode, FallbackValue='打开文件'}" />
                            <Button Style="{StaticResource AppleBtn}" Content="📂 选择图片" Command="{Binding PickImageCmd}" Margin="12,0,0,0" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedStep.ImageSource, FallbackValue='未选择图片'}" Margin="16,4,16,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="ROI（在采集到的图上拖拽绘制）" Margin="16,8,16,4" />
                        <ctrl:RoiImageView Height="220" Margin="14,0,14,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}" />
                        <UniformGrid Columns="4" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="W" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="H" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ========== 模板匹配 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="TemplateMatch">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="模板匹配" />
                        <Grid Margin="14,0,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="源图（从图像采集传入，ROI 拖拽绘制模板区域）" Margin="0,8,0,4" />
                                <ctrl:RoiImageView Height="220"
                                                   SourceImage="{Binding CurrentImageSource}"
                                                   RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                                   RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                                   RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                                   RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                                   Overlays="{Binding MatchOverlays}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" MinWidth="140">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="模板预览" Margin="0,8,0,4" />
                                <Border Width="140" Height="150" Background="{StaticResource PreviewBgBrush}" CornerRadius="10">
                                    <Grid>
                                        <Image Source="{Binding TemplatePreviewSource}" Width="140" Height="150" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TemplatePreviewSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image Source="{Binding TemplateContourOverlay}" Width="140" Height="150" Stretch="Uniform" IsHitTestVisible="False">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TemplateContourOverlay}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AppleBtn}" Content="确定模板" Command="{Binding ConfirmTemplateCmd}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AppleBtn}" Content="开始匹配" Command="{Binding StartMatchCmd}" />
                                    <TextBlock Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="{Binding SelectedStep.CostMs, StringFormat='匹配耗时：{0:F1}ms', FallbackValue='匹配耗时：0.0ms'}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="匹配模式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding MatchModes}" SelectedItem="{Binding SelectedStep.MatchMode, FallbackValue='灰度匹配'}" />
                        </DockPanel>
                        <!-- 轮廓匹配参数：仅轮廓匹配时显示（滑块 + 输入框） -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep.MatchMode}" Value="轮廓匹配">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓阈值(1-254)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="254" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourThreshold}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourThreshold, FallbackValue=30}" />
                                </Grid>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓模糊(0-12)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourBlur}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourBlur, FallbackValue=1.0, StringFormat={}{0:0.##}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="金字塔层数" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.PyramidLevel}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.PyramidLevel, FallbackValue=3}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度起始" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStart}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStart, FallbackValue=-180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度结束" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStop}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStop, FallbackValue=180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度步长" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStep}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStep, FallbackValue=1, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="重叠率" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Overlap}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Overlap, FallbackValue=0.3, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="最大匹配数" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.TopN}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TopN, FallbackValue=200}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="8,0">
                                <CheckBox Content="密集阵列（密集模式）"
                                          IsChecked="{Binding SelectedStep.DenseMode, Converter={StaticResource IntToBoolConverter}}"
                                          Style="{StaticResource AppleCheckBox}">
                                    <CheckBox.ToolTip>
                                        <TextBlock LineHeight="18">
                                            勾选=密集阵列（全检出，较慢，适合规则阵列/密集图）<LineBreak />
                                            不勾选=稀疏阵列（快速，默认）
                                        </TextBlock>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <TextBlock Style="{StaticResource AppleSubLabel}" Margin="22,2,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="默认不勾选=稀疏阵列(快速)；规则阵列/密集图才勾选=密集阵列(全检出,较慢)" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="尺度范围" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScaleRange}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScaleRange, FallbackValue=0, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="相似度阈值" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScoreThreshold}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScoreThreshold, FallbackValue=0.85, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="模板文件" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TemplateFile, FallbackValue=''}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 几何测量 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Measure">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="几何测量" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="测量类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding MeasureTypes}" SelectedItem="{Binding SelectedStep.MeasureType, FallbackValue='圆径'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="标称值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.NominalValue, FallbackValue=12.00}" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="公差(±)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Tolerance, FallbackValue=0.05}" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="ROI（在采集到的图上拖拽绘制）" Margin="16,8,16,4" />
                        <ctrl:RoiImageView Height="220" Margin="14,0,14,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}" />
                        <UniformGrid Columns="4" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="W" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="H" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ========== 逻辑判断 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Logic">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="逻辑判断" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="条件表达式" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.LogicExpression, FallbackValue='score >= 0.85'}" Width="180" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="True 分支" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="Pass" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="False 分支" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="NG" Width="80" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 结果输出 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Output">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="结果输出" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出地址" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputAddress, FallbackValue='PLC_D200'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputValue, FallbackValue=1}" Width="80" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
