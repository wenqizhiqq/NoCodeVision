                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" FontSize="11" Padding="4,2" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}" FontSize="11" Padding="4,2" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}" FontSize="11" Padding="4,2" />
                            </UniformGrid>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="最小面积(px)" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="2000" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.CountMinArea}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CountMinArea, FallbackValue=50}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出变量" ToolTip="数量结果写入的变量名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CountOutputVar, FallbackValue='nCount'}" Width="120" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 条码识别 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Code">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🔖 扫条码" /> — 读出二维码 / 条码里的文字</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：先在下面图上框出码所在的区域 → 1 选码类型 → 2 读出来的内容写进哪个变量，供后面判定或发出去。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="扫条码" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="码类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CodeTypes}" SelectedItem="{Binding SelectedStep.CodeType, FallbackValue='QR'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出变量" ToolTip="识别出的内容写入的变量名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CodeOutputVar, FallbackValue='sCode'}" Width="120" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 字符识别 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Ocr">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🔤 认文字" /> — 把图里的文字读成字符串</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：先在下面图上框出文字所在的区域 → 1 选识别语言 → 2 框的位置就是上面拖的框 → 3 读出来的文字写进哪个变量。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="认文字" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="识别语言" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding OcrLangs}" SelectedItem="{Binding SelectedStep.OcrLang, FallbackValue='数字'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="框的位置" ToolTip="识别区域：X/Y 左上角，W/H 宽高" />
                            <UniformGrid Columns="4" Width="200">
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" FontSize="11" Padding="4,2" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" FontSize="11" Padding="4,2" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}" FontSize="11" Padding="4,2" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}" FontSize="11" Padding="4,2" />
                            </UniformGrid>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出变量" ToolTip="识别出的文字写入的变量名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OcrOutputVar, FallbackValue='sText'}" Width="120" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 条件分支 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Branch">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🔀 走哪一条" /> — 按真假走不同后续步骤</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 写条件表达式 → 2 填真走哪一步 → 3 填假走哪一步，运行后按真假分流。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="走哪一条" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="条件表达式" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.BranchCondition, FallbackValue='score >= 0.85'}" Width="180" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="真分支步骤" ToolTip="条件成立时要执行的步骤名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.BranchTrue, FallbackValue='合格分支'}" Width="140" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="假分支步骤" ToolTip="条件不成立时要执行的步骤名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.BranchFalse, FallbackValue='不合格分支'}" Width="140" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 循环 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Loop">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🔁 重复做" /> — 重复执行一段步骤</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 选按次数还是按条件 → 2 填次数，或 3 填继续条件（如 i &lt; 10）→ 4 设循环变量名，它用来计数。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="重复做" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="循环类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding LoopTypes}" SelectedItem="{Binding SelectedStep.LoopType, FallbackValue='次数'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="循环次数" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.LoopCount, FallbackValue=3}" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="循环条件" ToolTip="循环类型为「条件」时生效" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.LoopCondition, FallbackValue='i &lt; 10'}" Width="140" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="4" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="循环变量" ToolTip="计数变量名，如 i" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.LoopVar, FallbackValue='i'}" Width="80" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 子流程 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="SubFlow">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="📑 调子流程" /> — 调用另一个已建好的流程</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 填要调用的子流程名字（就是左侧流程方案里的名字）→ 跑到这一步会先把那个流程执行完再继续。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="调子流程" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="子流程名" ToolTip="左侧流程方案里的流程名称" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.SubFlowName, FallbackValue=''}" Width="180" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 变量计算 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Calc">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🧮 算个数" /> — 用公式算出一个新值</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 在表达式里写运算（如 a + b * 2，可以用前面步骤的变量）→ 2 填结果写进哪个变量。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="算个数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="表达式" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CalcExpression, FallbackValue='a + b * 2'}" Width="200" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出变量" ToolTip="计算结果写入的变量名" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CalcOutputVar, FallbackValue='result'}" Width="120" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 数据保存 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Save">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="💾 存文件" /> — 把结果存成文件</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 选保存格式 → 2 填保存路径 → 3 填要存的字段（逗号分隔，如 time,score,result）→ 运行后落盘，用于报表和追溯。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="存文件" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="保存格式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding SaveFormats}" SelectedItem="{Binding SelectedStep.SaveFormat, FallbackValue='CSV'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="保存路径" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.SavePath, FallbackValue='Data/result.csv'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="保存字段" ToolTip="逗号分隔，如 time,score,result" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.SaveFields, FallbackValue='time,score,result'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 消息提示 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Notify">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="💬 弹提示" /> — 给用户一个提醒</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 填提示内容 → 2 选提示方式 → 3 选提示级别，运行到这一步就弹给操作员（完成 / 报警 / 分步引导）。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="弹提示" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="提示内容" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.NotifyMessage, FallbackValue='检测完成'}" Width="200" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="提示方式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding NotifyTypes}" SelectedItem="{Binding SelectedStep.NotifyType, FallbackValue='弹窗'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="提示级别" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding NotifyLevels}" SelectedItem="{Binding SelectedStep.NotifyLevel, FallbackValue='信息'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== Lua 脚本 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Lua">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="📝 Lua 脚本" /> — 用脚本做灵活的逻辑</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：先在下面的编辑框里写 Lua 脚本 → 需要时调 vision / plc 等接口 → 点运行，看输出面板的打印。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="Lua 脚本" />
                        <TextBox Style="{StaticResource AppleTextField}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Height="220" Margin="16,0,16,12"
                                 FontFamily="Consolas, Microsoft YaHei" Text="{Binding SelectedStep.LuaScript, FallbackValue=''}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <!-- 底部一行运行状态：始终可见，不跟着上面滚动；脚本页有自己的输出/诊断，这里就不占地方了 -->
        <Border Grid.Row="1" Margin="0,6,0,4" Padding="12,6" CornerRadius="8"
                Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} ｜ {1}：{2} ｜ 当前值 {3} ｜ {4:F1} ms">
                        <Binding Path="Status" />
                        <Binding Path="SelectedStep.Function" FallbackValue="未选中步骤" />
                        <Binding Path="SelectedStep.StatusText" FallbackValue="—" />
                        <Binding Path="SelectedStep.ValueText" FallbackValue="—" />
                        <Binding Path="SelectedStep.CostMs" FallbackValue="0" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>
        </Grid>
    </Grid>
</UserControl>
