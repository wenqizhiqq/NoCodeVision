                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="8" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="明暗方向" ToolTip="边缘灰度变化方向：由亮到暗 / 由暗到亮 / 任意"/>
