<UserControl x:Class="NoCodeVision.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             xmlns:views="clr-namespace:NoCodeVision.Views"
             xmlns:local="clr-namespace:NoCodeVision"
             mc:Ignorable="d">
<!-- 温启志：18719361399  混淆: 温d启i志v：g1n8i7v1z9f3f6a1f3x9w9 -->




    <UserControl.Resources>
        <local:IntToBoolConverter x:Key="IntToBoolConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:WidthToHeightConverter x:Key="WidthToHeight" />
        <local:BinPathConverter x:Key="BinPath" />
        <local:AspectHeightConverter x:Key="AspectHeight" />
        <local:FlowEmptyToVisibilityConverter x:Key="FlowEmptyToVisibilityConverter" />
        <ctrl:KindToVisibilityConverter x:Key="KindVis" />

        <!-- 引导卡样式（AppleGuideCard / AppleGuideTitle / AppleGuideText）已提到 Themes/AppleControls.xaml 全局复用 -->

        <!-- 「➕ 添加」二级菜单里的行 -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作序号圆点：右侧参数面板按「先做什么、后做什么」给每一行编号 -->
        <Style x:Key="OpBadge" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OpBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="FlowItemTemplate">
            <DockPanel LastChildFill="True" Margin="0,2,0,2">
                <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ComboBox DockPanel.Dock="Right" Style="{StaticResource AppleComboBoxInline}" Width="74" FontSize="10"
                          VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="主流程循环运行；复位流程在点「复位」时只运行一次"
                          SelectedValue="{Binding FlowRole}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="主流程" Tag="Main" />
                    <ComboBoxItem Content="复位流程" Tag="Reset" />
                </ComboBox>
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Steps.Count, StringFormat='{}{0} 步'}" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- 名字：双击就地改（也可以点列表下面的「✏️ 重命名」） -->
                <Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,0,12,0" Tag="{Binding}"
                               MouseLeftButtonUp="FlowName_MouseUp" ToolTip="双击改名">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AppleLabel}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" FontSize="13"
                             VerticalContentAlignment="Center" LostFocus="FlowNameEdit_LostFocus" KeyDown="FlowNameEdit_KeyDown"
                             IsVisibleChanged="FlowNameEdit_VisibleChanged" Tag="{Binding}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="StepItemTemplate">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" SharedSizeGroup="StepColFunc" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" SharedSizeGroup="StepColTime" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,4,0">
                    <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="20" />
                    <TextBlock Style="{StaticResource AppleLabel}" Margin="6,0,0,0" MaxWidth="132"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Function}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}. {1}">
                                <Binding Path="Index" />
                                <Binding Path="Function" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource AppleLabel}" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,4,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ActualValue}" />
                <TextBlock Grid.Column="2" Text="{Binding CostMs, StringFormat='{}{0:F1}'}" Style="{StaticResource AppleSubLabel}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,14,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CostMs, StringFormat='{}{0:F1} ms'}" />
                <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                           Fill="{StaticResource LineBrush}" Opacity="0.5" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程方案列表 -->
        <ctrl:AppleMasterList Grid.Column="0" Header="流程方案" HeaderIcon="🔀"
                              ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}"
                              AddCommand="{Binding AddFlowCmd}" DeleteCommand="{Binding DeleteFlowCmd}"
                              AddText="添加逻辑视觉"
                              ItemTemplate="{StaticResource FlowItemTemplate}">
            <ctrl:MasterListBehaviors.FooterContent>
                <WrapPanel Margin="8,0,0,0">
                    <Button Style="{StaticResource AppleBtn}" Content="📝 添加脚本流程" Command="{Binding AddScriptFlowCmd}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <Button Style="{StaticResource AppleBtnSecondary}" Content="✏️ 重命名" Command="{Binding RenameFlowCmd}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <Button Style="{StaticResource AppleBtn}" Content="🕹 添加运控" Command="{Binding AddMotionFlowCmd}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <Button Style="{StaticResource AppleBtn}" Content="🕸 添加节点图" Command="{Binding AddNodeGraphFlowCmd}" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <!--<Button Style="{StaticResource AppleBtn}" Content="🖼 添加视觉流程" Command="{Binding AddVisualFlowCmd}" VerticalAlignment="Center" Margin="0,0,8,8" />-->
                </WrapPanel>
            </ctrl:MasterListBehaviors.FooterContent>
        </ctrl:AppleMasterList>

        <!-- 脚本流程视图（选中脚本流程时显示，占中间+右侧两列） -->
        <views:ScriptFlowView Grid.Column="1" Grid.ColumnSpan="2" Margin="16,0" DataContext="{Binding}">
            <views:ScriptFlowView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:ScriptFlowView.Style>
        </views:ScriptFlowView>

        <!-- 视觉流程视图（选中视觉流程时显示，占中间一列；步骤/工具参数在右侧属性页设置） -->
        <views:VisualFlowView Grid.Column="1" Margin="16,0" DataContext="{Binding}">
            <views:VisualFlowView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Visual">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:VisualFlowView.Style>
        </views:VisualFlowView>

        <!-- 节点图流程视图（FlowKind=NodeGraph：左侧算子库拖到中间画布，右侧仍是同一套步骤属性页） -->
        <views:NodeGraphFlowView Grid.Column="1" Margin="16,0" DataContext="{Binding}">
            <views:NodeGraphFlowView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="NodeGraph">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:NodeGraphFlowView.Style>
        </views:NodeGraphFlowView>

        <!-- 中间：流程步骤（普通流程显示） -->
        <Grid Grid.Column="1" Margin="16,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Visual">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="NodeGraph">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource iOSTitle}" Text="{Binding SelectedFlow.Name, FallbackValue='流程'}" />

            <!-- 工具栏（操作按钮，紧凑单行；「➕ 添加」点开是两级菜单：一级分类、二级算子） -->
            <Border Grid.Row="1" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid>
                        <Button x:Name="AddToolBtn" Style="{StaticResource AppleBtn}" Content="➕ 添加" Click="AddToolBtn_Click" VerticalAlignment="Center" />
                        <Popup PlacementTarget="{Binding ElementName=AddToolBtn}" Placement="Bottom" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsAddMenuOpen, Mode=TwoWay}">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="8" MinWidth="460">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 一级：分类（MaxHeight 要和右侧列表一致，否则会被居中留出上下空白） -->
                                    <ListBox Grid.Column="0" Style="{StaticResource AppleListBox}" Background="Transparent" BorderThickness="0"
                                             ItemsSource="{Binding ToolGroups}" SelectedItem="{Binding SelectedToolGroup}"
                                             HorizontalContentAlignment="Stretch" VerticalAlignment="Top"
                                             MaxHeight="430" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource AppleLabel}" FontSize="13" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Tools.Count}" Style="{StaticResource AppleSubLabel}"
                                                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{StaticResource LineBrush}" Margin="2,4" />
                                    <!-- 二级：算子（图标 + 名字 + 一句说明），点一下加进流程，菜单不关 -->
                                    <ScrollViewer Grid.Column="1" MaxHeight="430" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedToolGroup.Tools}" Margin="4,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource MenuRow}" Height="Auto" Padding="10,5"
                                                            ToolTip="{Binding Desc}"
                                                            Command="{Binding DataContext.AddStepWithCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="15" Width="22"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding Desc}" FontSize="11" MaxWidth="330"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🗑 删除" Command="{Binding DeleteStepCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬆️ 上移" Command="{Binding MoveUpCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬇️ 下移" Command="{Binding MoveDownCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🧹 清空" Command="{Binding ClearCmd}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" /> 
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 步骤列表 -->
            <Border Grid.Row="2" Style="{StaticResource AppleGroupCard}" Padding="0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Height="36" Background="{StaticResource HoverBrush}" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" SharedSizeGroup="StepColFunc" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" SharedSizeGroup="StepColTime" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="功能" Style="{StaticResource AppleSubLabel}" Margin="14,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center"
                                   ToolTip="第几步 + 用的哪个算子" />
                        <TextBlock Grid.Column="1" Text="当前值" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center"
                                   ToolTip="这一步跑完的结果；角度类的步骤只显示多少度" />
                        <TextBlock Grid.Column="2" Text="耗时" Style="{StaticResource AppleSubLabel}" Margin="10,0,14,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFlow.Steps}" SelectedItem="{Binding SelectedStep}"
                             Style="{StaticResource AppleListBox}" ItemTemplate="{StaticResource StepItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             local:ListBoxBehaviors.AutoScrollToSelected="True">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppleListBoxItem}">
                                <Setter Property="Padding" Value="0,8,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- 空状态提示：未选中流程 -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                            Visibility="{Binding SelectedFlow, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="📋 还没有选中流程" Style="{StaticResource AppleLabel}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="左侧点「添加逻辑视觉」新建一个视觉流程，或选中已有流程开始编辑。"
                                       Style="{StaticResource AppleSubLabel}" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" MaxWidth="340" />
                        </StackPanel>
                    </Border>

                    <!-- 空状态提示：流程无步骤 -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                            Visibility="{Binding SelectedFlow, Converter={StaticResource FlowEmptyToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                            <TextBlock Text="➕ 这个流程还没有步骤" Style="{StaticResource AppleLabel}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="点上方「➕ 添加」，先选分类再点算子，点一个加一步。"
                                       Style="{StaticResource AppleSubLabel}" TextWrapping="Wrap" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" MaxWidth="340" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 底部调试工具栏：单步运行 / 全部运行 / 暂停·继续 / 停止 -->
            <Border Grid.Row="3" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Style="{StaticResource AppleBtn}" Content="▶ 单步运行" Command="{Binding StepRunCmd}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="▶▶ 全部运行" Command="{Binding RunCmd}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCmd}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="⏹ 停止" Command="{Binding StopCmd}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AppleStatusPill}">
                                <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#FFF3CD" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" Text="{Binding RunStateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Foreground" Value="#B58100" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧：步骤属性（按步骤类型动态切换；脚本流程隐藏） -->
        <Grid Grid.Column="2" Margin="16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 右侧面板的滚动条常驻：图上拖框区域/预览图的高度是按面板宽度算的，滚动条若时有时无，宽度跟着变，图就会一直放大缩小 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <!-- 通用参数面板：算子在 Vision/OperatorCatalog.cs 里登记后自动出界面，不必再写 XAML -->
                <Border Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGenericPanel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="{Binding SelectedOperatorName}" />
                        <Border Style="{StaticResource AppleGuideCard}" Margin="12,4,12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="{Binding SelectedOperatorDesc}" />
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="{Binding SelectedOperatorOrderText}"
                                           Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- 视觉类算子：框出要看的那一块，并指定结果写进哪个变量 -->
                        <StackPanel Visibility="{Binding SelectedOperatorUsesRoi, Converter={StaticResource KindVis}, ConverterParameter=True}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <StackPanel Orientation="Horizontal" Margin="14,6,14,4">
                                <Border Style="{StaticResource OpBadge}">
                                    <TextBlock Style="{StaticResource OpBadgeText}" Text="{Binding SelectedBlockRoiNo}" />
                                </Border>
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="要看哪一块（在图上按住鼠标拖一个框）"
                                           ToolTip="只有框里的内容参与计算；宽高填 0 表示整张图都算" />
                            </StackPanel>
                            <ctrl:RoiImageView Margin="12,0,12,8"
                                               Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToHeight}, ConverterParameter=0.7}"
                                               SourceImage="{Binding CurrentImageSource}"
                                               RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}"
                                               RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}"
                                               RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}"
                                               RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" />
                            <UniformGrid Columns="5" Margin="12,0,12,6">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" ToolTip="框左上角横坐标(像素)" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" ToolTip="框左上角纵坐标(像素)" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="宽" Style="{StaticResource AppleSubLabel}" FontSize="10" ToolTip="框宽度(像素)，0=整张图" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="高" Style="{StaticResource AppleSubLabel}" FontSize="10" ToolTip="框高度(像素)，0=整张图" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="角度" Style="{StaticResource AppleSubLabel}" FontSize="10" ToolTip="把框转一个角度再用，斜着放的零件用它对齐" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiAngle, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <!-- 零样本查瑕疵：选一张标准（OK）图 -->
                        <StackPanel Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter=ZeroShotAnomaly}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                    <TextBlock Style="{StaticResource OpBadgeText}" Text="{Binding SelectedBlockGoldenNo}" />
                                </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="标准图" Width="70" />
                                <Button Style="{StaticResource AppleBtn}" Content="📂 选标准图" Command="{Binding PickGoldenImageCmd}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedStep.TemplateFile, Converter={StaticResource BinPath}, FallbackValue='还没有选'}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,8,0"
                                           ToolTip="{Binding SelectedStep.TemplateFile, Converter={StaticResource BinPath}}" />
                            </DockPanel>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SelectedOperatorParams}" Margin="12,0,12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="106" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource OpBadge}">
                                            <TextBlock Style="{StaticResource OpBadgeText}" Text="{Binding No}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="{Binding Help}" />
                                        <DockPanel Grid.Column="2" LastChildFill="True"
                                                   Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter='Number,Text'}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource AppleBtn}" Content="📂" Width="34" MinWidth="34"
                                                    Padding="0" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                    Visibility="{Binding IsPath, Converter={StaticResource KindVis}, ConverterParameter=True}"
                                                    Command="{Binding DataContext.PickPathCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="点这个选文件或文件夹" />
                                            <TextBox Style="{StaticResource AppleTextField}"
                                                     ctrl:DynBind.Target="Text" ctrl:DynBind.Path="{Binding Path=Path}"
                                                     ToolTip="{Binding Help}" />
                                        </DockPanel>
                                        <CheckBox Grid.Column="2" Content="要" VerticalAlignment="Center" FontSize="12"
                                                  Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Bool}"
                                                  ctrl:DynBind.Target="Checked" ctrl:DynBind.Path="{Binding Path=Path}"
                                                  ToolTip="{Binding Help}" />
                                        <ComboBox Grid.Column="2" Style="{StaticResource AppleComboBox}" ItemsSource="{Binding Options}"
                                                  Visibility="{Binding Kind, Converter={StaticResource KindVis}, ConverterParameter=Choice}"
                                                  ctrl:DynBind.Target="Selected" ctrl:DynBind.Path="{Binding Path=Path}"
                                                  ToolTip="{Binding Help}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 跳转 / 跳转到：落点解析 + 被谁调用 -->
                        <StackPanel Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter='Jump,JumpTo'}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}"
                                       Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter=Jump}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="会跳到哪" Width="70" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedJumpResolve}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource AppleRow}"
                                       Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter=JumpTo}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="谁跳到这" Width="70" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedLabelCallers}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        <!-- 通讯类步骤：不用跑流程就能测通不通 -->
                        <StackPanel Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter='ModbusWrite,ModbusRead,ModbusReadArr,TcpSend'}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                    <TextBlock Style="{StaticResource OpBadgeText}" Text="{Binding SelectedBlockTestNo}" />
                                </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="连接测试" />
                                <Button Style="{StaticResource AppleBtn}" Content="🔌 测一下" Command="{Binding TestModbusCmd}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding ModbusStatus}" Margin="8,0,8,0"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                        <!-- 显示结果：先看当前图，跑一次后这里就是画好的结果图 -->
                        <StackPanel x:Name="ShowResultPreviewHost" Visibility="{Binding SelectedStep.StepType, Converter={StaticResource KindVis}, ConverterParameter='ShowResult,ZeroShotAnomaly'}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="预览（跑一次后这里就变成画好的结果图）" Margin="14,6,14,4" />
                            <Border x:Name="ShowResultPreviewBox" Margin="12,0,12,10" CornerRadius="8" ClipToBounds="True" Background="{StaticResource CanvasBrush}">
                                <StackPanel>
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="还没有图：先在「拍张照片」选一张，或直接跑一次流程"
                                           Margin="12,10,12,0"
                                           Visibility="{Binding ResultPreview, Converter={StaticResource NullToVisibilityConverter}}" />
                                <ctrl:ZoomPanImage Source="{Binding ResultPreview}" Height="{Binding ActualWidth, ElementName=ShowResultPreviewBox, Converter={StaticResource WidthToHeight}, ConverterParameter=0.8333}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- 最后一步：结果写进哪个变量 -->
                        <StackPanel Visibility="{Binding SelectedOperatorUsesRoi, Converter={StaticResource KindVis}, ConverterParameter=True}">
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                    <TextBlock Style="{StaticResource OpBadgeText}" Text="{Binding SelectedBlockOutputNo}" />
                                </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="结果写入"
                                           ToolTip="把这一步的实测值存进这个变量，后面判定、发PLC、存表都取它" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputVar, Mode=TwoWay, FallbackValue=dMeasure}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="跑完读数是" />
                                <TextBlock Text="{Binding SelectedStep.ActualValue, FallbackValue=还没运行}" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource iOSTitle}" TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="SelectedStep.Function" FallbackValue="步骤属性" />
                                        <Binding Path="SelectedStep.Name" FallbackValue="" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Measure">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                <Binding Path="SelectedStep.MeasureType" FallbackValue="几何测量" />
                                                <Binding Path="SelectedStep.Name" FallbackValue="" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 未选中步骤时的引导提示 -->
                <Border Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="步骤属性" />
                        <TextBlock Style="{StaticResource AppleGuideText}" Text="在中间步骤列表选中一个步骤，这里会显示它的参数；要加新步骤就点上方「➕ 添加」。" TextWrapping="Wrap" Margin="14,0,14,4" />
                    </StackPanel>
                </Border>

                <!-- ========== 图像采集 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="ImageCapture">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 参数在上、图像在下：图占满整张卡片宽度 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="📷 拍张照片" /> — 给后续步骤提供一张图</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1 选「采集方式」，再点右边那个按钮把图拿到 → 2~3 这一步用的就是这张图（选「打开文件夹」时每跑一次换下一张）→ 4~10 只有接相机才用，用本地图片这几行不用动 → 11~12 用迈德威视相机时才出现 → 最后在下面的图上拖一个框（不框=整张图），然后跑流程。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="先拿到一张图" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="采集方式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedStep.CaptureMode, FallbackValue='打开文件'}" />
                            <Button Command="{Binding PickImageCmd}" Margin="12,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AppleBtn}">
                                        <Setter Property="Content" Value="📂 选图片" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedStep.CaptureMode}" Value="打开文件夹">
                                                <Setter Property="Content" Value="📂 选文件夹" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedStep.CaptureMode}" Value="采集相机">
                                                <Setter Property="Content" Value="📷 拍一张" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedStep.CaptureMode}" Value="迈德威视相机">
                                                <Setter Property="Content" Value="📷 抓一张" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像源" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageSource, Converter={StaticResource BinPath}, FallbackValue=''}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <!-- 「打开文件夹」时把文件夹亮出来：不然只看到一个空图像源，不知道图从哪来 -->
                        <StackPanel Visibility="{Binding SelectedStep.CaptureMode, Converter={StaticResource KindVis}, ConverterParameter=打开文件夹}">
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图片文件夹"
                                           ToolTip="流程每跑一次这一步换下一张，跑完一轮从头开始" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.FolderPath, Converter={StaticResource BinPath}, FallbackValue='还没选'}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding CaptureFolderInfo, FallbackValue=''}"
                                       Margin="16,0,16,6" TextWrapping="Wrap" />
                            <Rectangle Style="{StaticResource AppleDivider}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="相机参数（只有选相机才用，用本地图片这几行不用动）" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="4" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="曝光(us)（越大越亮）" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Exposure, FallbackValue=8000}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="5" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="增益（亮度放大）" ToolTip="画面信号放大倍数。调高会变亮，但噪点也变多" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Gain, FallbackValue=10}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="6" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="拍照时机" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CaptureTriggerModes}" SelectedItem="{Binding SelectedStep.TriggerMode, FallbackValue='连续采集'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="7" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="像素格式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CapturePixelFormats}" SelectedItem="{Binding SelectedStep.PixelFormat, FallbackValue='RGB8'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="8" />
                        </Border>
                            <Grid Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="分辨率宽(px)" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageWidth, FallbackValue=2448}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="分辨率高(px)" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageHeight, FallbackValue=2048}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="9" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像格式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedStep.ImageFormat, FallbackValue='PNG'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="10" />
                        </Border>
                            <Grid Margin="6,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="自动曝光（自动调亮）"
                                              IsChecked="{Binding SelectedStep.AutoExposure, Converter={StaticResource IntToBoolConverter}}"
                                              Style="{StaticResource AppleCheckBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="保存原图"
                                              IsChecked="{Binding SelectedStep.SaveImage, Converter={StaticResource IntToBoolConverter}}"
                                              Style="{StaticResource AppleCheckBox}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                        <!-- 迈德威视：面阵/线扫共用一块，勾了线扫才要行频和拼帧行数 -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep.CaptureMode}" Value="迈德威视相机">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="11" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="相机" />
                                <Button Style="{StaticResource AppleBtn}" Content="🔄 刷新" Command="{Binding RefreshCamerasCmd}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <Button Style="{StaticResource AppleBtn}" Content="📷 抓一张" Command="{Binding GrabCameraCmd}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                <ComboBox Style="{StaticResource AppleComboBox}" ItemsSource="{Binding MindVisionDevices}"
                                          SelectedIndex="{Binding SelectedStep.CameraIndex, Mode=TwoWay, FallbackValue=0}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding MindVisionStatus}" Margin="16,2,16,4" TextWrapping="Wrap" />
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="12" />
                            </Border>
                                <CheckBox Content="线扫" DockPanel.Dock="Left" Style="{StaticResource AppleCheckBox}"
                                          IsChecked="{Binding SelectedStep.CameraLineScan, Mode=TwoWay}" ToolTip="线扫相机：靠行频一行一行拍，攒够「每帧行数」拼成一张图" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="行频(Hz)（线扫速度）" Margin="16,0,6,0" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="80" DockPanel.Dock="Left"
                                         Text="{Binding SelectedStep.CameraLineRate, Mode=TwoWay, FallbackValue=10000}" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="每张图拍多少行" Margin="12,0,6,0" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.CameraSpliceLines, Mode=TwoWay, FallbackValue=1024}" />
                            </DockPanel>
                        </StackPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedStep.ImageSource, Converter={StaticResource BinPath}, FallbackValue='未选择图片'}" Margin="16,4,16,4" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- 下：ROI 图像（整卡宽度） -->
                        <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="检测范围（在下面的图上拖一个框）" Margin="0,8,0,4" ToolTip="在右边的图上按住鼠标拖出一个框，软件只看框里的内容" />
                        <ctrl:RoiImageView Margin="0,0,0,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}">
                            <ctrl:RoiImageView.Height>
                                <MultiBinding Converter="{StaticResource AspectHeight}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ImagePixelWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ImagePixelHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </ctrl:RoiImageView.Height>
                        </ctrl:RoiImageView>
                        <UniformGrid Columns="4" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="W" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="H" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== 模板匹配 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="TemplateMatch">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 参数左 250px，源图右 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="🎯 图里找图案" /> — 在图里找到目标的位置</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：先在右边源图上按住拖一个框，把要找的图案框住，点「确定模板」→ 1 选匹配模式 → 2~5 找不准时再微调：结果排序 / 边缘填充 / 最小匹配间距 / 忽略背景 → 6 模板文件：想换图复用就从这里改。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图里找图案" />
                        <!-- 模板预览（参数列） -->
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="模板预览（框住的那一小块）" Margin="0,8,0,4" />
                            <Border Width="140" Height="150" Background="{StaticResource PreviewBgBrush}" CornerRadius="10">
                                <Grid>
                                    <Image Source="{Binding TemplatePreviewSource}" Width="140" Height="150" Stretch="Uniform">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemplatePreviewSource}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <Image Source="{Binding TemplateContourOverlay}" Width="140" Height="150" Stretch="Uniform" IsHitTestVisible="False">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TemplateContourOverlay}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource AppleBtn}" Content="确定模板" Command="{Binding ConfirmTemplateCmd}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource AppleBtn}" Content="开始匹配" Command="{Binding StartMatchCmd}" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="{Binding SelectedStep.CostMs, StringFormat='匹配耗时：{0:F1}ms', FallbackValue='匹配耗时：0.0ms'}" />
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="匹配模式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding MatchModes}" SelectedItem="{Binding SelectedStep.MatchMode, FallbackValue='灰度匹配'}" />
                        </DockPanel>
                        <!-- 轮廓匹配参数：仅轮廓匹配时显示（滑块 + 输入框） -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep.MatchMode}" Value="轮廓匹配">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓清晰度(1-254)" VerticalAlignment="Center" ToolTip="按外形找图的严格程度，范围 1~254，越大越只看轮廓" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="254" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourThreshold}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourThreshold, FallbackValue=30}" />
                                </Grid>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓模糊(0-12)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourBlur}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourBlur, FallbackValue=1.0, StringFormat={}{0:0.##}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="缩小几层去找" VerticalAlignment="Center" ToolTip="找图的快慢折中：层数多找得快但可能漏找，一般 3~5 层" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.PyramidLevel}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.PyramidLevel, FallbackValue=3}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度起始" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStart}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStart, FallbackValue=-180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度结束" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStop}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStop, FallbackValue=180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度步长" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStep}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStep, FallbackValue=1, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="重叠率" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Overlap}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Overlap, FallbackValue=0.3, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="最大匹配数" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.TopN}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TopN, FallbackValue=200}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="8,0">
                                <CheckBox Content="密集阵列（密集模式）"
                                          IsChecked="{Binding SelectedStep.DenseMode, Converter={StaticResource IntToBoolConverter}}"
                                          Style="{StaticResource AppleCheckBox}">
                                    <CheckBox.ToolTip>
                                        <TextBlock LineHeight="18">
                                            勾选=密集阵列（全检出，较慢，适合规则阵列/密集图）<LineBreak />
                                            不勾选=稀疏阵列（快速，默认）
                                        </TextBlock>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <TextBlock Style="{StaticResource AppleSubLabel}" Margin="22,2,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="默认不勾选=稀疏阵列(快速)；规则阵列/密集图才勾选=密集阵列(全检出,较慢)" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="尺度范围" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScaleRange}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScaleRange, FallbackValue=0, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="相似度（像不像）" VerticalAlignment="Center" ToolTip="分数达到多少才算找到了。0~1之间，越大越严格；一般填 0.7~0.85" />
                            <Slider Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScoreThreshold}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScoreThreshold, FallbackValue=0.85, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="结果排序" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding SortBys}" SelectedItem="{Binding SelectedStep.SortBy, FallbackValue='相似度'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘填充" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding BorderModes}" SelectedItem="{Binding SelectedStep.BorderMode, FallbackValue='常数填充'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="4" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="最小匹配间距(px)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.MinDistance, FallbackValue=10}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="5" />
                        </Border>
                            <CheckBox Content="忽略背景（掩膜）"
                                      IsChecked="{Binding SelectedStep.UseMask, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="6" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="模板文件（存下来的那一小块图）" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TemplateFile, FallbackValue=''}" />
                        </DockPanel>
                        </StackPanel>
                        <!-- 右：源图（ROI 拖拽绘制模板区域） -->
                        <StackPanel Grid.Column="1" Margin="14,0,14,0">
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="源图（从「拍张照片」传入，在右侧图上拖拽绘制模板区域）" Margin="0,8,0,4" />
                        <ctrl:RoiImageView Margin="0,0,0,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}">
                            <ctrl:RoiImageView.Height>
                                <MultiBinding Converter="{StaticResource AspectHeight}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ImagePixelWidth" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="ImagePixelHeight" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </ctrl:RoiImageView.Height>
                        </ctrl:RoiImageView>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== 几何测量 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Measure">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- 参数左 250px，ROI 图像右 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">

                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="📐 量尺寸" /> — 量一个几何量并判合格</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：先在下面图上框出要量的地方 → 1 选测量类型 → 2~3 填标称值和公差（合格不合格就看这两个）→ 4~5 单位和保留小数位 → 6 实测值写进哪个变量 → 7~9 量不准再微调取点数量 / 明暗方向 / 边缘明显程度 → 10 框的位置就是上面拖的框，不用手填。" />
                            </StackPanel>
                        </Border>
                        <!-- 1. 测量摘要：明确回答「测量了什么」 -->
                        <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14" Margin="16,12,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="测量目标："/>
                                        <Run Text="{Binding SelectedStep.MeasureType, FallbackValue='圆径'}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding SelectedStep.NominalValue, FallbackValue=12}" FontWeight="Bold"/>
                                        <Run Text=" ± "/>
                                        <Run Text="{Binding SelectedStep.Tolerance, FallbackValue=0.05}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedStep.MeasureUnit, FallbackValue='像素'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="输出变量：" />
                                        <Run Text="{Binding SelectedStep.OutputVar, FallbackValue='dMeasure'}"/>
                                        <Run Text="  ·  判定逻辑：|实测值 − 标称值| ≤ 公差"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="实测值 / 判定" HorizontalAlignment="Right" ToolTip="这一次量出来的数字，以及它算不算合格" />
                                    <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"
                                               Text="--"
                                               Foreground="{StaticResource TextMutedBrush}" ToolTip="运行流程后在此显示实际测量值"/>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Text="未运行"
                                               Foreground="{StaticResource TextMutedBrush}" ToolTip="判定逻辑：|实测值 − 标称值| ≤ 公差"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. 测量规格：两列紧凑布局 + 每个参数带 ToolTip -->
                        <TextBlock Grid.Row="1" Style="{StaticResource AppleSectionHeader}" Text="测量规格" Margin="16,0,16,6"/>
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="测量类型" ToolTip="要测量的几何量：圆径、边距、角度、面积、中心距"/>
                                <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                          ItemsSource="{Binding MeasureTypes}" SelectedItem="{Binding SelectedStep.MeasureType, FallbackValue='圆径'}" />
                            </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="标称值" ToolTip="目标理论值，实测值围绕此值判定 OK/NG"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.NominalValue, FallbackValue=12.00}" />
                            </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                                <TextBlock Style="{StaticResource OpBadgeText}" Text="3" />
                            </Border>
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="公差(±)" ToolTip="允许偏离标称值的最大范围"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.Tolerance, FallbackValue=0.05}" />
                            </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                            <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
