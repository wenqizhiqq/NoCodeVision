<UserControl x:Class="NoCodeVision.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             xmlns:views="clr-namespace:NoCodeVision.Views"
             xmlns:local="clr-namespace:NoCodeVision"
             mc:Ignorable="d">

    <UserControl.Resources>
        <local:IntToBoolConverter x:Key="IntToBoolConverter" />

        <DataTemplate x:Key="FlowItemTemplate">
            <DockPanel LastChildFill="True" Margin="0,2,0,2">
                <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Steps.Count, StringFormat='{}{0} 步'}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" Margin="0,0,12,0" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="StepItemTemplate">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition SharedSizeGroup="StepColLogic" />
                    <ColumnDefinition SharedSizeGroup="StepColFunc" />
                    <ColumnDefinition SharedSizeGroup="StepColName" />
                    <ColumnDefinition SharedSizeGroup="StepColStatus" />
                    <ColumnDefinition SharedSizeGroup="StepColOp" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition SharedSizeGroup="StepColTime" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.LogicRelations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding LogicRelation, FallbackValue='如果'}" VerticalAlignment="Center" Margin="14,0,4,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                    <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="20" />
                    <TextBlock Text="{Binding Function}" Style="{StaticResource AppleLabel}" Margin="6,0,0,0"
                               MaxWidth="70" TextTrimming="CharacterEllipsis" ToolTip="{Binding Function}" />
                </StackPanel>
                <TextBox Grid.Column="2" Text="{Binding Name, FallbackValue=''}" Style="{StaticResource AppleTextFieldInline}"
                         TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,4,0"
                         ToolTip="{Binding Name}" />
                <ComboBox Grid.Column="3" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding StatusText, FallbackValue='未开始'}" VerticalAlignment="Center" Margin="10,0,4,0" />
                <ComboBox Grid.Column="4" Style="{StaticResource AppleComboBoxInline}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.Operators, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding Operator, FallbackValue='大于'}" VerticalAlignment="Center" Margin="10,0,4,0" />
                <TextBox Grid.Column="5" Text="{Binding InputValue, FallbackValue=''}" Style="{StaticResource AppleTextFieldInline}"
                         TextAlignment="Left" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,4,0"
                         ToolTip="{Binding InputValue}" />
                <TextBlock Grid.Column="6" Text="{Binding CostMs, StringFormat='{}{0:F1}'}" Style="{StaticResource AppleSubLabel}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,14,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CostMs, StringFormat='{}{0:F1} ms'}" />
                <Rectangle Grid.Column="0" Grid.ColumnSpan="7" Height="1" VerticalAlignment="Bottom"
                           Fill="{StaticResource LineBrush}" Opacity="0.5" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程方案列表 -->
        <ctrl:AppleMasterList Grid.Column="0" Header="流程方案" HeaderIcon="🔀"
                              ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}"
                              AddCommand="{Binding AddFlowCmd}" DeleteCommand="{Binding DeleteFlowCmd}"
                              ItemTemplate="{StaticResource FlowItemTemplate}">
            <ctrl:MasterListBehaviors.FooterContent>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource AppleBtn}" Content="📝 添加脚本流程" Command="{Binding AddScriptFlowCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleBtnSecondary}" Content="✏️ 重命名" Command="{Binding RenameFlowCmd}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </ctrl:MasterListBehaviors.FooterContent>
        </ctrl:AppleMasterList>

        <!-- 脚本流程视图（选中脚本流程时显示，占中间+右侧两列） -->
        <views:ScriptFlowView Grid.Column="1" Grid.ColumnSpan="2" Margin="16,0" DataContext="{Binding}">
            <views:ScriptFlowView.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:ScriptFlowView.Style>
        </views:ScriptFlowView>

        <!-- 中间：流程步骤（普通流程显示） -->
        <Grid Grid.Column="1" Margin="16,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource iOSTitle}" Text="{Binding SelectedFlow.Name, FallbackValue='流程'}" />

            <!-- 工具栏（新建步骤 + 操作按钮，紧凑单行） -->
            <Border Grid.Row="1" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource AppleComboBox}" Width="150" VerticalAlignment="Center"
                              ItemsSource="{Binding StepFunctions}" SelectedItem="{Binding NewStepFunction}" />
                    <Button Style="{StaticResource AppleBtn}" Content="➕ 添加" Command="{Binding AddStepCmd}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🗑 删除" Command="{Binding DeleteStepCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬆️ 上移" Command="{Binding MoveUpCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="⬇️ 下移" Command="{Binding MoveDownCmd}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="🧹 清空" Command="{Binding ClearCmd}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 步骤列表 -->
            <Border Grid.Row="2" Style="{StaticResource AppleGroupCard}" Padding="0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Height="36" Background="{StaticResource HoverBrush}" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75" SharedSizeGroup="StepColLogic" />
                            <ColumnDefinition Width="110" SharedSizeGroup="StepColFunc" />
                            <ColumnDefinition Width="110" SharedSizeGroup="StepColName" />
                            <ColumnDefinition Width="95" SharedSizeGroup="StepColStatus" />
                            <ColumnDefinition Width="85" SharedSizeGroup="StepColOp" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="65" SharedSizeGroup="StepColTime" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="逻辑" Style="{StaticResource AppleSubLabel}" Margin="14,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="功能" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="运算" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="输入值" Style="{StaticResource AppleSubLabel}" Margin="10,0,4,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="耗时" Style="{StaticResource AppleSubLabel}" Margin="10,0,14,0" FontWeight="SemiBold" Height="14" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFlow.Steps}" SelectedItem="{Binding SelectedStep}"
                             Style="{StaticResource AppleListBox}" ItemTemplate="{StaticResource StepItemTemplate}"
                             local:ListBoxBehaviors.AutoScrollToSelected="True">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppleListBoxItem}">
                                <Setter Property="Padding" Value="0,8,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 底部调试工具栏：单步运行 / 全部运行 / 暂停·继续 / 停止 -->
            <Border Grid.Row="3" Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button Style="{StaticResource AppleBtn}" Content="▶ 单步运行" Command="{Binding StepRunCmd}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="▶▶ 全部运行" Command="{Binding RunCmd}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0,12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCmd}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource AppleBtn}" Content="⏹ 停止" Command="{Binding StopCmd}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource AppleStatusPill}">
                                <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Background" Value="#FFF3CD" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="12" Text="{Binding RunStateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Foreground" Value="#B58100" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧：步骤属性（按步骤类型动态切换；脚本流程隐藏） -->
        <ScrollViewer Grid.Column="2" Margin="16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedFlow.FlowKind}" Value="Script">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
                <TextBlock>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource iOSTitle}" TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="SelectedStep.Function" FallbackValue="步骤属性" />
                                        <Binding Path="SelectedStep.Name" FallbackValue="" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Measure">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0} - {1}">
                                                <Binding Path="SelectedStep.MeasureType" FallbackValue="几何测量" />
                                                <Binding Path="SelectedStep.Name" FallbackValue="" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ========== 图像采集 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="ImageCapture">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="相机参数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像源" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageSource, FallbackValue=''}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="曝光(us)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Exposure, FallbackValue=8000}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="增益" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Gain, FallbackValue=10}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="触发模式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CaptureTriggerModes}" SelectedItem="{Binding SelectedStep.TriggerMode, FallbackValue='连续采集'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="像素格式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CapturePixelFormats}" SelectedItem="{Binding SelectedStep.PixelFormat, FallbackValue='RGB8'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,8,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="分辨率宽(px)" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageWidth, FallbackValue=2448}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="分辨率高(px)" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageHeight, FallbackValue=2048}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像格式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedStep.ImageFormat, FallbackValue='PNG'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="自动曝光"
                                          IsChecked="{Binding SelectedStep.AutoExposure, Converter={StaticResource IntToBoolConverter}}"
                                          Style="{StaticResource AppleCheckBox}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Content="保存原图"
                                          IsChecked="{Binding SelectedStep.SaveImage, Converter={StaticResource IntToBoolConverter}}"
                                          Style="{StaticResource AppleCheckBox}" />
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="采集方式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CaptureModes}" SelectedItem="{Binding SelectedStep.CaptureMode, FallbackValue='打开文件'}" />
                            <Button Style="{StaticResource AppleBtn}" Content="📂 选择图片" Command="{Binding PickImageCmd}" Margin="12,0,0,0" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding SelectedStep.ImageSource, FallbackValue='未选择图片'}" Margin="16,4,16,4" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="ROI（在采集到的图上拖拽绘制）" Margin="16,8,16,4" />
                        <ctrl:RoiImageView Height="220" Margin="14,0,14,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}" />
                        <UniformGrid Columns="4" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="W" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="H" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ========== 模板匹配 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="TemplateMatch">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="模板匹配" />
                        <Grid Margin="14,0,14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="源图（从图像采集传入，ROI 拖拽绘制模板区域）" Margin="0,8,0,4" />
                                <ctrl:RoiImageView Height="220"
                                                   SourceImage="{Binding CurrentImageSource}"
                                                   RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                                   RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                                   RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                                   RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                                   Overlays="{Binding MatchOverlays}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" MinWidth="140">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="模板预览" Margin="0,8,0,4" />
                                <Border Width="140" Height="150" Background="{StaticResource PreviewBgBrush}" CornerRadius="10">
                                    <Grid>
                                        <Image Source="{Binding TemplatePreviewSource}" Width="140" Height="150" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TemplatePreviewSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <Image Source="{Binding TemplateContourOverlay}" Width="140" Height="150" Stretch="Uniform" IsHitTestVisible="False">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TemplateContourOverlay}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AppleBtn}" Content="确定模板" Command="{Binding ConfirmTemplateCmd}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource AppleBtn}" Content="开始匹配" Command="{Binding StartMatchCmd}" />
                                    <TextBlock Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="{Binding SelectedStep.CostMs, StringFormat='匹配耗时：{0:F1}ms', FallbackValue='匹配耗时：0.0ms'}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="匹配模式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding MatchModes}" SelectedItem="{Binding SelectedStep.MatchMode, FallbackValue='灰度匹配'}" />
                        </DockPanel>
                        <!-- 轮廓匹配参数：仅轮廓匹配时显示（滑块 + 输入框） -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep.MatchMode}" Value="轮廓匹配">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓阈值(1-254)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="254" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourThreshold}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourThreshold, FallbackValue=30}" />
                                </Grid>
                                <Rectangle Style="{StaticResource AppleDivider}" />
                                <Grid Margin="16,4,16,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="轮廓模糊(0-12)" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                            Value="{Binding SelectedStep.ContourBlur}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ContourBlur, FallbackValue=1.0, StringFormat={}{0:0.##}}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="金字塔层数" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.PyramidLevel}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.PyramidLevel, FallbackValue=3}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度起始" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStart}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStart, FallbackValue=-180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度结束" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStop}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStop, FallbackValue=180}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="角度步长" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.AngleStep}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.AngleStep, FallbackValue=1, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="重叠率" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Overlap}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Overlap, FallbackValue=0.3, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="最大匹配数" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.TopN}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TopN, FallbackValue=200}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Vertical" Margin="8,0">
                                <CheckBox Content="密集阵列（密集模式）"
                                          IsChecked="{Binding SelectedStep.DenseMode, Converter={StaticResource IntToBoolConverter}}"
                                          Style="{StaticResource AppleCheckBox}">
                                    <CheckBox.ToolTip>
                                        <TextBlock LineHeight="18">
                                            勾选=密集阵列（全检出，较慢，适合规则阵列/密集图）<LineBreak />
                                            不勾选=稀疏阵列（快速，默认）
                                        </TextBlock>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <TextBlock Style="{StaticResource AppleSubLabel}" Margin="22,2,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="默认不勾选=稀疏阵列(快速)；规则阵列/密集图才勾选=密集阵列(全检出,较慢)" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="尺度范围" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScaleRange}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScaleRange, FallbackValue=0, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="相似度阈值" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.3" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.ScoreThreshold}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScoreThreshold, FallbackValue=0.85, StringFormat={}{0:0.##}}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="结果排序" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding SortBys}" SelectedItem="{Binding SelectedStep.SortBy, FallbackValue='相似度'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘填充" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="130"
                                      ItemsSource="{Binding BorderModes}" SelectedItem="{Binding SelectedStep.BorderMode, FallbackValue='常数填充'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="最小匹配间距(px)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.MinDistance, FallbackValue=10}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <CheckBox Content="启用掩膜(忽略背景)"
                                      IsChecked="{Binding SelectedStep.UseMask, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="模板文件" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TemplateFile, FallbackValue=''}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 几何测量 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Measure">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. 测量摘要：明确回答「测量了什么」 -->
                        <Border Grid.Row="0" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14" Margin="16,12,16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="测量目标："/>
                                        <Run Text="{Binding SelectedStep.MeasureType, FallbackValue='圆径'}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding SelectedStep.NominalValue, FallbackValue=12}" FontWeight="Bold"/>
                                        <Run Text=" ± "/>
                                        <Run Text="{Binding SelectedStep.Tolerance, FallbackValue=0.05}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding SelectedStep.MeasureUnit, FallbackValue='像素'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="输出变量："/>
                                        <Run Text="{Binding SelectedStep.OutputVar, FallbackValue='dMeasure'}"/>
                                        <Run Text="  ·  判定逻辑：|实测值 − 标称值| ≤ 公差"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="实测值 / 判定" HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"
                                               Text="--"
                                               Foreground="{StaticResource TextMutedBrush}" ToolTip="运行流程后在此显示实际测量值"/>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Text="未运行"
                                               Foreground="{StaticResource TextMutedBrush}" ToolTip="判定逻辑：|实测值 − 标称值| ≤ 公差"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. 测量规格：两列紧凑布局 + 每个参数带 ToolTip -->
                        <TextBlock Grid.Row="1" Style="{StaticResource AppleSectionHeader}" Text="测量规格" Margin="16,0,16,6"/>
                        <Grid Grid.Row="2" Margin="16,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Column="0" Grid.Row="0" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="测量类型" ToolTip="要测量的几何量：圆径、边距、角度、面积、中心距"/>
                                <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                          ItemsSource="{Binding MeasureTypes}" SelectedItem="{Binding SelectedStep.MeasureType, FallbackValue='圆径'}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Grid.Row="0" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="标称值" ToolTip="目标理论值，实测值围绕此值判定 OK/NG"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.NominalValue, FallbackValue=12.00}" />
                            </DockPanel>

                            <DockPanel Grid.Column="0" Grid.Row="1" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="公差(±)" ToolTip="允许偏离标称值的最大范围"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.Tolerance, FallbackValue=0.05}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Grid.Row="1" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="单位" ToolTip="测量结果与标称值的显示单位"/>
                                <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="100"
                                          ItemsSource="{Binding MeasureUnits}" SelectedItem="{Binding SelectedStep.MeasureUnit, FallbackValue='像素'}" />
                            </DockPanel>

                            <DockPanel Grid.Column="0" Grid.Row="2" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="小数位" ToolTip="测量结果保留的小数位数"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.Decimals, FallbackValue=3}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Grid.Row="2" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出变量" ToolTip="测量结果写入的变量名，供后续步骤或脚本读取"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="100"
                                         Text="{Binding SelectedStep.OutputVar, FallbackValue='dMeasure'}" />
                            </DockPanel>
                        </Grid>

                        <!-- 3. 算法参数：同样两列 + ToolTip -->
                        <TextBlock Grid.Row="3" Style="{StaticResource AppleSectionHeader}" Text="算法参数" Margin="16,4,16,6"/>
                        <Grid Grid.Row="4" Margin="16,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Column="0" Grid.Row="0" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="卡尺数" ToolTip="边缘搜索时沿轮廓采集的测量点数，越多越稳定但越慢"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.CaliperCount, FallbackValue=20}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Grid.Row="0" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘极性" ToolTip="边缘灰度变化方向：由亮到暗 / 由暗到亮 / 任意"/>
                                <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                          ItemsSource="{Binding EdgePolarities}" SelectedItem="{Binding SelectedStep.EdgePolarity, FallbackValue='由亮到暗'}" />
                            </DockPanel>

                            <DockPanel Grid.Column="0" Grid.Row="1" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘阈值" ToolTip="判定边缘的最小灰度差，越小越灵敏"/>
                                <TextBox DockPanel.Dock="Left" Style="{StaticResource AppleTextField}" Width="80"
                                         Text="{Binding SelectedStep.EdgeThreshold, FallbackValue=20}" />
                            </DockPanel>
                            <DockPanel Grid.Column="1" Grid.Row="1" Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="ROI 坐标" ToolTip="感兴趣区域：X/Y 为左上角坐标，W/H 为宽高，可直接在下方图中拖拽绘制"/>
                                <UniformGrid Columns="4" Width="130">
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=0}" FontSize="11" Padding="4,2" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=0}" FontSize="11" Padding="4,2" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}" FontSize="11" Padding="4,2" />
                                    <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}" FontSize="11" Padding="4,2" />
                                </UniformGrid>
                            </DockPanel>
                        </Grid>

                        <!-- 5. ROI 视图 + 详细提示 -->
                        <TextBlock Grid.Row="5" Style="{StaticResource AppleSubLabel}" Text="ROI 预览（在图上拖拽绘制区域，测量算法只在该区域内搜索边缘）" Margin="16,8,16,4" />
                        <ctrl:RoiImageView Grid.Row="6" Height="240" Margin="14,0,14,10"
                                           SourceImage="{Binding CurrentImageSource}"
                                           RoiX="{Binding SelectedStep.RoiX, Mode=TwoWay, FallbackValue=10}"
                                           RoiY="{Binding SelectedStep.RoiY, Mode=TwoWay, FallbackValue=10}"
                                           RoiW="{Binding SelectedStep.RoiW, Mode=TwoWay, FallbackValue=120}"
                                           RoiH="{Binding SelectedStep.RoiH, Mode=TwoWay, FallbackValue=80}"
                                           Overlays="{Binding MatchOverlays}"
                                           Measures="{Binding MeasureAnnotations}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource AppleSubLabel}" Text="提示：切换左上角工具可框选 ROI / 拉线段测距 / 标圆测半径；运行后「实测值/判定」会在此显示结果。" Margin="16,0,16,8" />
                    </Grid>
                </Border>

                <!-- ========== 逻辑判断 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Logic">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="逻辑判断" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="条件表达式" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.LogicExpression, FallbackValue='score >= 0.85'}" Width="180" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="True 分支" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="Pass" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="False 分支" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="NG" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="比较变量" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CompareVar, FallbackValue='score'}" Width="120" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="比较来源" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140"
                                      ItemsSource="{Binding CompareSources}" SelectedItem="{Binding SelectedStep.CompareSource, FallbackValue='匹配分数'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="备注" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Remark, FallbackValue=''}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 结果输出 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Output">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="结果输出" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出地址" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputAddress, FallbackValue='PLC_D200'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputValue, FallbackValue=1}" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding OutputTypes}" SelectedItem="{Binding SelectedStep.OutputType, FallbackValue='PLC'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="数据类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding DataTypes}" SelectedItem="{Binding SelectedStep.DataType, FallbackValue='整数'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="触发方式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding OutputTriggers}" SelectedItem="{Binding SelectedStep.Trigger, FallbackValue='立即'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="失败处理" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding OnFails}" SelectedItem="{Binding SelectedStep.OnFail, FallbackValue='忽略'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <CheckBox Content="写后读校验"
                                      IsChecked="{Binding SelectedStep.Verify, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 缺陷检测 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Defect">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷检测预览" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource SurfaceBrush}" Height="280" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="未加载流程图片" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentImageSource}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ctrl:RoiImageView SourceImage="{Binding CurrentImageSource}" Overlays="{Binding MatchOverlays}" DefectOverlay="{Binding DefectOverlayImage}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷参数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="差异阈值" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding SelectedStep.DiffThreshold, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.DiffThreshold, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="最小面积占比" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0.001" Maximum="0.05" Value="{Binding SelectedStep.MinAreaFrac, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.MinAreaFrac, StringFormat={}{0:F3}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="全局亮度阈值" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding SelectedStep.GlobalBrightnessThresh, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.GlobalBrightnessThresh, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘容差" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="30" Value="{Binding SelectedStep.EdgeTolerance, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.EdgeTolerance, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘梯度" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding SelectedStep.EdgeGradThresh, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.EdgeGradThresh, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="腐蚀核" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="15" Value="{Binding SelectedStep.ErodeSize, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.ErodeSize, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="膨胀核" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="15" Value="{Binding SelectedStep.DilateSize, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding SelectedStep.DilateSize, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding DefectSummaryText}" Foreground="#DC2626" Margin="0,4,0,8" />
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource SurfaceBrush}" MaxHeight="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FlowDefectResults}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10" Height="10" Fill="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource AppleSubLabel}" TextWrapping="Wrap">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}: 面积{1:F0}px, 中心({2:F1},{3:F1}), 角度{4:F1}°">
                                                            <Binding Path="Category" />
                                                            <Binding Path="Area" />
                                                            <Binding Path="CenterX" />
                                                            <Binding Path="CenterY" />
                                                            <Binding Path="Angle" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
        <Button Content="开始检测缺陷" Style="{StaticResource AppleBtn}"
                Margin="0,12,0,0" HorizontalAlignment="Stretch"
                Command="{Binding RunDefectCmd}" />
                    </StackPanel>
                </Border>

                <!-- ========== 轴运动 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="AxisMove">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴运动" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="目标轴" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="150"
                                      ItemsSource="{Binding AxisNames}" SelectedItem="{Binding SelectedStep.TargetAxis, FallbackValue='X轴'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="运动类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="150"
                                      ItemsSource="{Binding MoveTypes}" SelectedItem="{Binding SelectedStep.MoveType, FallbackValue='绝对运动'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="运动模式" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="150"
                                      ItemsSource="{Binding MoveModes}" SelectedItem="{Binding SelectedStep.MoveMode, FallbackValue='点位运动'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="目标位置" Margin="16,8,16,4" />
                        <UniformGrid Columns="3" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TargetX, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TargetY, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Z" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TargetZ, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="速度" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Speed}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Speed, FallbackValue=50}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="加速度" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Accel}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Accel, FallbackValue=100}" />
                        </Grid>
                        <Grid Margin="16,4,16,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource AppleSubLabel}" Text="减速度" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="1" Maximum="1000" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStep.Decel}" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Grid.Column="2" Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Decel, FallbackValue=100}" />
                        </Grid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="到位超时(ms)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.InPosTimeout, FallbackValue=5000}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <CheckBox Content="伺服使能"
                                      IsChecked="{Binding SelectedStep.ServoOn, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== IO 控制 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="IOControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="IO 控制" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="IO 类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding IoTypes}" SelectedItem="{Binding SelectedStep.IoType, FallbackValue='输出'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="IO 通道" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="140" IsEditable="True"
                                      ItemsSource="{Binding IoChannels}" SelectedItem="{Binding SelectedStep.IoChannel, FallbackValue='DO_0'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出值" />
                            <CheckBox Content="开"
                                      IsChecked="{Binding SelectedStep.IoValue, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <CheckBox Content="等待完成"
                                      IsChecked="{Binding SelectedStep.WaitDone, Converter={StaticResource IntToBoolConverter}}"
                                      Style="{StaticResource AppleCheckBox}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 气缸动作 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Cylinder">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="气缸动作" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="气缸名称" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CylName, FallbackValue='气缸1'}" Width="140" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="动作" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding CylActions}" SelectedItem="{Binding SelectedStep.CylAction, FallbackValue='伸出'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="到位传感器" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.SensorIn, FallbackValue='IN_0'}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="缩回传感器" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.SensorOut, FallbackValue='IN_1'}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="动作超时(ms)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CylTimeout, FallbackValue=3000}" Width="100" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 等待延时 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Wait">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="等待延时" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="等待类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding WaitTypes}" SelectedItem="{Binding SelectedStep.WaitType, FallbackValue='时间'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="等待时间(ms)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.WaitTime, FallbackValue=1000}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="等待条件" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.WaitCondition, FallbackValue='signal == 1'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 通讯指令 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Comm">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="通讯指令" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="通讯通道" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CommChannel, FallbackValue='PLC-串口'}" Width="140" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="指令类型" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding CommCmds}" SelectedItem="{Binding SelectedStep.CommCmd, FallbackValue='发送'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="编码" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
                                      ItemsSource="{Binding CommEncodings}" SelectedItem="{Binding SelectedStep.CommEncoding, FallbackValue='ASCII'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="指令内容" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.CommContent, FallbackValue='M100=1'}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
