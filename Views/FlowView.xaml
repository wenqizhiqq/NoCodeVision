                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘阈值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.EdgeThreshold, FallbackValue=20}" Width="80" />
