                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Remark, FallbackValue=''}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ========== 结果输出 ========== -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedStep.StepType}" Value="Output">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Border Style="{StaticResource AppleGuideCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AppleGuideTitle}"><Run Text="📤 报结果" /> — 把结果写到 PLC / 变量</TextBlock>
                                <TextBlock Style="{StaticResource AppleGuideText}" Text="操作顺序：1~2 填输出地址和要输出的值 → 3~4 选输出类型与数据类型（要和 PLC 那边收法一致）→ 5 选触发方式 → 6 选失败怎么办 → 7 想确认对方真收到了就勾「写后读校验」。" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="报结果" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="1" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出地址" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputAddress, FallbackValue='PLC_D200'}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                        <Border DockPanel.Dock="Left" Style="{StaticResource OpBadge}">
                            <TextBlock Style="{StaticResource OpBadgeText}" Text="2" />
                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="输出值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.OutputValue, FallbackValue=1}" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
