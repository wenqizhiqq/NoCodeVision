                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TargetY, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
