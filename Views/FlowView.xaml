<UserControl x:Class="NoCodeVision.Views.FlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="FlowItemTemplate">
            <DockPanel LastChildFill="True" Margin="0,2,0,2">
                <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="28" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Steps.Count, StringFormat='{}{0} 步'}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" Margin="0,0,12,0" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="StepItemTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ctrl:AppleIconTile Glyph="{Binding Icon}" TileSize="22" />
                    <TextBlock Text="{Binding Function}" Style="{StaticResource AppleLabel}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding Timeout}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CostMs, StringFormat='{}{0:F1}'}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding ActualValue}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：流程方案列表 -->
        <ctrl:AppleMasterList Grid.Column="0" Header="流程方案" HeaderIcon="🔀"
                              ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}"
                              AddCommand="{Binding AddFlowCmd}" DeleteCommand="{Binding DeleteFlowCmd}"
                              ItemTemplate="{StaticResource FlowItemTemplate}" />

        <!-- 中间：流程步骤 -->
        <Grid Grid.Column="1" Margin="16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource iOSTitle}" Text="{Binding SelectedFlow.Name, FallbackValue='流程'}" />

            <!-- 新建步骤 -->
            <Border Grid.Row="1" Style="{StaticResource AppleGroupCard}" Padding="14">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Left" Text="新建步骤类型" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="150"
                              ItemsSource="{Binding StepFunctions}" SelectedItem="{Binding NewStepFunction}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource AppleBtn}" Content="➕ 添加" Command="{Binding AddStepCmd}" Margin="12,0,0,0" />
                </DockPanel>
            </Border>

            <!-- 工具栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Style="{StaticResource AppleIconBtn}" Content="🗑 删除" Command="{Binding DeleteStepCmd}" />
                <Button Style="{StaticResource AppleIconBtn}" Content="⬆️ 上移" Command="{Binding MoveUpCmd}" />
                <Button Style="{StaticResource AppleIconBtn}" Content="⬇️ 下移" Command="{Binding MoveDownCmd}" />
                <Button Style="{StaticResource AppleIconBtn}" Content="🧹 清空" Command="{Binding ClearCmd}" />
                <Button Style="{StaticResource AppleBtn}" Content="▶ 运行流程" Command="{Binding RunCmd}" />
                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>

            <!-- 步骤列表 -->
            <Border Grid.Row="3" Style="{StaticResource AppleGroupCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 表头 -->
                    <Grid Grid.Row="0" Height="36" Background="{StaticResource HoverBrush}" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="序号" Style="{StaticResource AppleSubLabel}" Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="功能" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="名称" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="超时" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="耗时" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="结果" Style="{StaticResource AppleSubLabel}" Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFlow.Steps}" SelectedItem="{Binding SelectedStep}"
                             Style="{StaticResource AppleListBox}" ItemTemplate="{StaticResource StepItemTemplate}">
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppleListBoxItem}" />
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 右侧：步骤属性 -->
        <ScrollViewer Grid.Column="2" Margin="16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Style="{StaticResource iOSTitle}" Text="步骤属性" />

                <!-- 分段页签 -->
                <Border Style="{StaticResource AppleGroupCard}" Padding="4">
                    <ListBox ItemsSource="{Binding PropTabs}" SelectedItem="{Binding ActivePropTab}"
                             Style="{StaticResource AppleSegmentedTab}" />
                </Border>

                <!-- 图像 -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePropTab}" Value="图像">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="图像" />
                        <!-- ROI 画布 -->
                        <ctrl:RoiCanvas Height="220" Margin="14,0,14,10"
                                        RoiX="{Binding SelectedStep.RoiX, FallbackValue=10}"
                                        RoiY="{Binding SelectedStep.RoiY, FallbackValue=10}"
                                        RoiW="{Binding SelectedStep.RoiW, FallbackValue=120}"
                                        RoiH="{Binding SelectedStep.RoiH, FallbackValue=80}"
                                        ImageSource="{Binding SelectedStep.ImageSource, FallbackValue=''}" />
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="图像源" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ImageSource, FallbackValue=''}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="模板文件" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.TemplateFile, FallbackValue=''}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="ROI（可拖拽绘制）" Margin="16,8,16,4" />
                        <UniformGrid Columns="4" Margin="16,0,16,8">
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="X" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiX, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Y" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiY, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="W" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiW, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="H" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.RoiH, FallbackValue=0}" TextAlignment="Left" HorizontalAlignment="Stretch" MinWidth="0" />
                            </StackPanel>
                        </UniformGrid>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="匹配阈值" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.ScoreThreshold, FallbackValue=0.85}" Width="80" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Lua -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePropTab}" Value="Lua">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="Lua 脚本" />
                        <!-- AI 提示气泡 -->
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource AppleHintBubble}" TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep.HasAiHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SelectedStep.AiHint}" TextWrapping="Wrap" FontSize="12" Foreground="#8A6D0B" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="14,0,14,10">
                            <Button Style="{StaticResource AppleBtn}" Content="💡 AI 提示" Command="{Binding AskAiCmd}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AppleBtnSecondary}" Content="▶ 运行" Command="{Binding RunLuaCmd}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AppleBtnSecondary}" Content="🐛 调试" Command="{Binding DebugLuaCmd}" />
                        </StackPanel>
                        <TextBox Style="{StaticResource AppleCodeEditor}"
                                 Text="{Binding SelectedStep.LuaScript, FallbackValue=''}"
                                 MinHeight="180" Margin="14,0,14,14" />
                    </StackPanel>
                </Border>

                <!-- 参数设置 -->
                <Border>
                    <Border.Style>
                        <Style BasedOn="{StaticResource AppleGroupCard}" TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActivePropTab}" Value="参数设置">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="参数设置" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="超时(ms)" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedStep.Timeout, FallbackValue=3000}" Width="100" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="重试次数" />
                            <TextBox Style="{StaticResource AppleTextField}" Text="3" Width="80" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" Text="扩展参数（key=value 每行一个）" Margin="16,8,16,4" />
                        <TextBox Style="{StaticResource AppleCodeEditor}"
                                 Text="{Binding SelectedStep.Parameters, FallbackValue=''}"
                                 MinHeight="120" Margin="14,0,14,14" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
