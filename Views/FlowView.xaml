                        </Border>
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="什么时候报" />
                            <ComboBox DockPanel.Dock="Left" Style="{StaticResource AppleComboBox}" Width="120"
