<UserControl x:Class="NoCodeVision.Views.EngineerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             xmlns:views="clr-namespace:NoCodeVision.Views"
             mc:Ignorable="d">
<!-- 温启志：18719361399  工程师台：左侧选功能，右侧直接操作流程 / 相机 / 通讯 / 运控（比操作员多） -->

    <UserControl.Resources>
        <ctrl:KindToVisibilityConverter x:Key="KindVis" />

        <!-- 左侧功能页签 -->
        <Style x:Key="EngTabItem" TargetType="ListBoxItem" BasedOn="{StaticResource AppleListBoxItem}">
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- 流程列表行 -->
        <DataTemplate x:Key="EngFlowRow">
            <StackPanel Margin="2,3">
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="10.5" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="{Binding Steps.Count, Mode=OneWay}" /><Run Text=" 步 · " /><Run Text="{Binding FlowKind, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 步骤行：序号 / 功能 / 状态 / 当前值 / 耗时 -->
        <DataTemplate x:Key="EngStepRow">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}"
                        Width="22" Height="22" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Index}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Function}" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,6,0" />
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" Text="{Binding CostMs, StringFormat={}{0:0.0} ms}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </DataTemplate>

        <!-- 轴调试行 -->
        <DataTemplate x:Key="DebugAxisTemplate">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource AppleLabel}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource AppleSubLabel}" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding Value, StringFormat={}{0:F2}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Unit, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource AppleIconBtn}" Content="使能" Margin="0,0,4,0"
                            Command="{Binding DataContext.EnableAxisCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="回原点" Margin="0,0,4,0"
                            Command="{Binding DataContext.HomeAxisCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="−JOG" Margin="0,0,4,0"
                            Command="{Binding DataContext.JogMinusCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="+JOG" Margin="0,0,4,0"
                            Command="{Binding DataContext.JogPlusCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="−寸动" Margin="0,0,4,0"
                            Command="{Binding DataContext.InchMinusCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Style="{StaticResource AppleIconBtn}" Content="+寸动"
                            Command="{Binding DataContext.InchPlusCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DebugIoTemplate">
            <Grid Margin="12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="切换"
                            Command="{Binding DataContext.ToggleOutputCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AppleIconBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="输入">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DebugCylinderTemplate">
            <Grid Margin="12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource AppleLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource AppleIconBtn}" Content="切换"
                        Command="{Binding DataContext.ToggleCylinderCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左：功能页签 ===== -->
        <Border Grid.Column="0" Style="{StaticResource AppleGroupCard}" Padding="10,8" Margin="0,0,12,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource AppleSectionHeader}" Text="工程师台" />
                <TextBlock DockPanel.Dock="Top" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,10"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="比操作员多：能挑流程跑、能连相机和通讯、能手动点动轴。" />
                <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,2">
                    <Rectangle Style="{StaticResource AppleDivider}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding FlowCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding CameraCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding CommCountText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Style="{StaticResource AppleListBox}" ItemContainerStyle="{StaticResource EngTabItem}"
                         VerticalAlignment="Top">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Hint}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== 右：功能页 ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,8,12">
                <TextBlock Style="{StaticResource iOSTitle}" Text="{Binding TabTitle}" />

                <!-- ============ 总览 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Home}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="系统信息" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="版本" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Version}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="运行环境" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Runtime}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="视觉引擎" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding EngineInfo}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="授权" />
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding License}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="现场接了多少东西" />
                            <WrapPanel Margin="14,4,14,12">
                                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding FlowCountText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding CameraCountText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding CommCountText}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="运行模式 / 日志级别" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="运行模式" Margin="14,2,14,0" />
                            <ListBox ItemsSource="{Binding RunningModes}" SelectedItem="{Binding RunningMode}"
                                     Style="{StaticResource ApplePillList}" Margin="10,2,10,8" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="日志级别" Margin="14,0,14,0" />
                            <ListBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                                     Style="{StaticResource ApplePillList}" Margin="10,2,10,12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGuideCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleGuideTitle}" Text="细参数回各自页面改" />
                            <TextBlock Style="{StaticResource AppleGuideText}" Text="这一页只做运行和粗调；改步骤、加算子、改相机具体参数，点下面的按钮过去。" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource AppleBtn}" Content="流程页（改步骤和参数）" Command="{Binding GoFlowPageCmd}" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="相机页" Command="{Binding GoCameraPageCmd}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="通讯页" Command="{Binding GoCommPageCmd}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="运控页" Command="{Binding GoMotionPageCmd}" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 流程控制 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Flow}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="挑一个流程来跑" />
                            <WrapPanel Margin="14,0,14,10">
                                <Button Style="{StaticResource AppleBtn}" Content="▶▶ 全部运行" Command="{Binding FlowVm.RunCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtn}" Content="▶ 单步运行" Command="{Binding FlowVm.StepRunCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="{Binding FlowVm.PauseResumeText}" Command="{Binding FlowVm.PauseResumeCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="⏹ 停止" Command="{Binding FlowVm.StopCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="去流程页编辑" Command="{Binding GoFlowPageCmd}" Margin="0,0,8,6" />
                                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center" Margin="4,0,0,6">
                                    <TextBlock Text="{Binding FlowVm.Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                            </WrapPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="215" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" ItemsSource="{Binding FlowVm.Flows}"
                                         SelectedItem="{Binding FlowVm.SelectedFlow, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource EngFlowRow}"
                                         Style="{StaticResource AppleListBox}" MaxHeight="420" Margin="10,0,10,10" />
                                <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{StaticResource LineBrush}" Margin="0,4" />
                                <StackPanel Grid.Column="1" Margin="12,0,14,10">
                                    <TextBlock Style="{StaticResource AppleSubLabel}" Text="这一步做什么 · 跑完的状态 / 读数 / 耗时" Margin="0,0,0,2" />
                                    <ItemsControl ItemsSource="{Binding FlowVm.SelectedFlow.Steps}" ItemTemplate="{StaticResource EngStepRow}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 相机 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Camera}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="连接与采集" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="用哪台相机" />
                                <ComboBox Style="{StaticResource AppleComboBox}" Width="240" HorizontalAlignment="Left"
                                          ItemsSource="{Binding CameraVm.Cameras}"
                                          SelectedItem="{Binding CameraVm.SelectedCamera, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <WrapPanel Margin="14,0,14,10">
                                <Button Style="{StaticResource AppleBtn}" Content="连接" Command="{Binding CameraVm.ConnectCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtn}" Content="开始采集 / 抓一张" Command="{Binding CameraVm.StartCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="停止" Command="{Binding CameraVm.StopCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="去相机页" Command="{Binding GoCameraPageCmd}" Margin="0,0,8,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="画面亮度（现场快速调）" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="曝光时间" Width="90" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="90" HorizontalAlignment="Right"
                                         Text="{Binding CameraVm.Exposure, StringFormat={}{0:F1}}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="增益（放大）" Width="90" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="90" HorizontalAlignment="Right"
                                         Text="{Binding CameraVm.Gain, StringFormat={}{0:F1}}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="拍照时机" Width="90" />
                                <ComboBox Style="{StaticResource AppleComboBox}" Width="150" HorizontalAlignment="Left"
                                          ItemsSource="{Binding CameraVm.TriggerModes}" SelectedItem="{Binding CameraVm.TriggerMode, Mode=TwoWay}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="像素格式" Width="90" />
                                <ComboBox Style="{StaticResource AppleComboBox}" Width="150" HorizontalAlignment="Left"
                                          ItemsSource="{Binding CameraVm.PixelFormats}" SelectedItem="{Binding CameraVm.PixelFormat, Mode=TwoWay}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 通讯 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Comm}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="连通道" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="用哪个通道" />
                                <ComboBox Style="{StaticResource AppleComboBox}" Width="220" HorizontalAlignment="Left"
                                          ItemsSource="{Binding CommVm.Configs}"
                                          SelectedItem="{Binding CommVm.SelectedConfig, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <WrapPanel Margin="14,0,14,10">
                                <Button Style="{StaticResource AppleBtn}" Content="连接" Command="{Binding CommVm.ConnectCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="断开" Command="{Binding CommVm.DisconnectCmd}" Margin="0,0,8,6" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="去通讯页" Command="{Binding GoCommPageCmd}" Margin="0,0,16,6" />
                                <Border VerticalAlignment="Center" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource AppleStatusPill}">
                                            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommVm.IsConnected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="未连接" />
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommVm.IsConnected}" Value="True">
                                                        <Setter Property="Text" Value="已连接" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="发一条试试" />
                            <DockPanel Style="{StaticResource AppleRow}">
                                <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="内容" Width="50" />
                                <Button Style="{StaticResource AppleBtn}" Content="发送" DockPanel.Dock="Right" Command="{Binding CommVm.SendCmd}" Margin="8,0,0,0" />
                                <TextBox Style="{StaticResource AppleTextField}"
                                         Text="{Binding CommVm.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="收发记录" Margin="14,6,14,4" />
                            <ListBox ItemsSource="{Binding CommVm.DebugLog}" Height="200" Margin="14,0,14,8" Style="{StaticResource AppleTerminal}" />
                            <DockPanel Style="{StaticResource AppleRow}" LastChildFill="False">
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="清空记录" Command="{Binding CommVm.ClearLogCmd}" DockPanel.Dock="Left" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 运控调试 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Motion}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴（真实驱动硬件）" />
                            <DockPanel Style="{StaticResource AppleRow}" LastChildFill="False">
                                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Left" Text="寸动步长" ToolTip="点一次「寸动」，轴走多远" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="70" Text="{Binding InchStep}" />
                                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Left" Text="  JOG 步长" Margin="14,0,0,0" />
                                <TextBox Style="{StaticResource AppleTextField}" Width="70" Text="{Binding JogStep}" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="去运控页" Command="{Binding GoMotionPageCmd}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                            </DockPanel>
                            <Rectangle Style="{StaticResource AppleDivider}" />
                            <ListBox ItemsSource="{Binding DebugAxes}" ItemTemplate="{StaticResource DebugAxisTemplate}"
                                     Style="{StaticResource AppleListBox}" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="IO（输入只读 · 输出可切换）" />
                            <ListBox ItemsSource="{Binding DebugIo}" ItemTemplate="{StaticResource DebugIoTemplate}"
                                     Style="{StaticResource AppleListBox}" BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="气缸（伸出 / 缩回）" />
                            <ListBox ItemsSource="{Binding DebugCylinders}" ItemTemplate="{StaticResource DebugCylinderTemplate}"
                                     Style="{StaticResource AppleListBox}" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 日志 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Log}">
                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="运行模式 / 日志级别" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="运行模式" Margin="14,2,14,0" />
                            <ListBox ItemsSource="{Binding RunningModes}" SelectedItem="{Binding RunningMode}"
                                     Style="{StaticResource ApplePillList}" Margin="10,2,10,8" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" Text="日志级别" Margin="14,0,14,0" />
                            <ListBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"
                                     Style="{StaticResource ApplePillList}" Margin="10,2,10,12" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleGroupCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource AppleSectionHeader}" Text="调试日志" />
                            <ListBox ItemsSource="{Binding LogEntries}" Height="260" Margin="14,4,14,10" Style="{StaticResource AppleTerminal}" />
                            <DockPanel Style="{StaticResource AppleRow}" LastChildFill="False">
                                <Button Style="{StaticResource AppleBtn}" Content="导出日志" Command="{Binding ExportCmd}" DockPanel.Dock="Left" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="清空" Command="{Binding ClearCmd}" DockPanel.Dock="Left" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 智能中心 ============ -->
                <StackPanel Visibility="{Binding SelectedTab.Key, Converter={StaticResource KindVis}, ConverterParameter=Smart}">
                    <views:SmartCenterView DataContext="{Binding SmartVm, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
