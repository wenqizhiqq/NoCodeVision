<UserControl x:Class="NoCodeVision.Views.MotionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:NoCodeVision.Helpers"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 紧凑字段：标签在上、输入在下，固定宽度以便两列换行排布 -->
        <Style x:Key="AxisField" TargetType="Grid">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="AxisLabel" TargetType="TextBlock" BasedOn="{StaticResource AppleLabel}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部一行 tab -->
        <Border Grid.Row="0" Style="{StaticResource AppleGroupCard}" Padding="10" Margin="0,0,0,12">
            <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ApplePillListItem}">
                        <Setter Property="Padding" Value="14,6" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- 下方左右分栏：左列表，右属性 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" />
                <ColumnDefinition Width="70*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 轴 ===== -->
            <Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="轴">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AppleBtn}" Content="新增" Command="{Binding AddCmd}" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding DeleteCmd}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="12,0,0,0" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名" Command="{Binding RenameCmd}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis, Mode=TwoWay}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="90" />
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="70" />
                                <GridViewColumn Header="当前位置" DisplayMemberBinding="{Binding Value, StringFormat={}{0:F2}}" Width="90" />
                                <GridViewColumn Header="单位" DisplayMemberBinding="{Binding Unit}" Width="50" />
                                <GridViewColumn Header="使能" DisplayMemberBinding="{Binding Enabled}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="轴">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="轴参数" Width="100000" Margin="0,0,0,4" />
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="名称" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.Name, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="速度" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.Speed, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="加速度" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.Acceleration, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="减速度" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.Deceleration, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="回零偏移" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.HomeOffset, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="正软限位" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.SoftLimitPos, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="负软限位" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.SoftLimitNeg, StringFormat={}{0:F2}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="备注" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedAxis.Note, FallbackValue=''}" />
                    </Grid>
                </WrapPanel>
            </Border>

            <!-- ===== IO ===== -->
            <Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="IO">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AppleBtn}" Content="新增" Command="{Binding AddCmd}" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding DeleteCmd}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="12,0,0,0" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名" Command="{Binding RenameCmd}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding IoPoints}" SelectedItem="{Binding SelectedIo, Mode=TwoWay}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="100" />
                                <GridViewColumn Header="地址" DisplayMemberBinding="{Binding Address}" Width="70" />
                                <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="70" />
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="70" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="IO">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="IO 参数" Width="100000" Margin="0,0,0,4" />
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="名称" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedIo.Name, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="地址" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedIo.Address, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="类型" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedIo.Type, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="延迟 (ms)" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedIo.Delay, StringFormat={}{0:F1}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="说明" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedIo.Note, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="极性" />
                        <CheckBox Grid.Row="1" IsChecked="{Binding SelectedIo.Polarity}" Content="高电平有效" VerticalAlignment="Center" />
                    </Grid>
                </WrapPanel>
            </Border>

            <!-- ===== 气缸 ===== -->
            <Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="气缸">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AppleBtn}" Content="新增" Command="{Binding AddCmd}" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding DeleteCmd}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="12,0,0,0" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名" Command="{Binding RenameCmd}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Cylinders}" SelectedItem="{Binding SelectedCylinder, Mode=TwoWay}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="120" />
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Status}" Width="80" />
                                <GridViewColumn Header="动作" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource AppleBtn}" Content="伸出" Padding="8,2" FontSize="12"
                                                        Command="{x:Static helpers:CylinderCommandBridge.ExtendCmd}" CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource AppleBtnSecondary}" Content="缩回" Padding="8,2" FontSize="12" Margin="6,0,0,0"
                                                        Command="{x:Static helpers:CylinderCommandBridge.RetractCmd}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="气缸">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="气缸参数" Width="100000" Margin="0,0,0,4" />
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="名称" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.Name, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="状态" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.Status, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="动作" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.Action, FallbackValue=''}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="伸出时间 (ms)" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.ExtendTime, StringFormat={}{0:F1}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="缩回时间 (ms)" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.RetractTime, StringFormat={}{0:F1}, FallbackValue=0}" />
                    </Grid>
                    <Grid Style="{StaticResource AxisField}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource AxisLabel}" Text="延迟 (ms)" />
                        <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding SelectedCylinder.Delay, StringFormat={}{0:F1}, FallbackValue=0}" />
                    </Grid>
                </WrapPanel>
            </Border>

            <!-- ===== 轴点位表 ===== -->
            <Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="轴点位表">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AppleBtn}" Content="新增" Command="{Binding AddCmd}" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding DeleteCmd}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="12,0,0,0" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名" Command="{Binding RenameCmd}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding PointTables}" SelectedItem="{Binding SelectedPointTable, Mode=TwoWay}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="点位表名" DisplayMemberBinding="{Binding Name}" Width="140" />
                                <GridViewColumn Header="点数" DisplayMemberBinding="{Binding Points.Count}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="轴点位表">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 选中表内的点位列表 -->
                    <Border Grid.Column="0" Padding="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource AppleBtn}" Content="新增点" Command="{Binding AddPointCmd}" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="删除点" Command="{Binding DeletePointCmd}" Margin="8,0,0,0" />
                                <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="12,0,0,0" />
                                <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名点" Command="{Binding RenamePointCmd}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{Binding SelectedPointTable.Points}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}" BorderThickness="0">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="点位名" DisplayMemberBinding="{Binding Name}" Width="90" />
                                        <GridViewColumn Header="X" DisplayMemberBinding="{Binding X, StringFormat={}{0:F1}}" Width="56" />
                                        <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Y, StringFormat={}{0:F1}}" Width="56" />
                                        <GridViewColumn Header="Z" DisplayMemberBinding="{Binding Z, StringFormat={}{0:F1}}" Width="56" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                    <!-- 点位属性 -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="点位参数" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,8,0,4" Text="点位名" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Name, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="X" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.X, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="Y" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Y, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="Z" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Z, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="偏移 X" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.OffsetX, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="偏移 Y" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.OffsetY, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="偏移 Z" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.OffsetZ, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="速度" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Speed, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="说明" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Desc, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="备注" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedPoint.Note, FallbackValue=''}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 料盘 ===== -->
            <Border Grid.Column="0" Padding="12" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="料盘">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource AppleBtn}" Content="新增" Command="{Binding AddCmd}" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding DeleteCmd}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="12,0,0,0" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重命名" Command="{Binding RenameCmd}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{Binding Trays}" SelectedItem="{Binding SelectedTray, Mode=TwoWay}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="料盘名" DisplayMemberBinding="{Binding Name}" Width="140" />
                                <GridViewColumn Header="行×列" DisplayMemberBinding="{Binding GridText}" Width="70" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="料盘">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- 选中料盘的格子 -->
                    <Border Grid.Column="0" Padding="0,0,12,0">
                        <ItemsControl ItemsSource="{Binding SelectedTray.Cells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding SelectedTray.Rows}" Columns="{Binding SelectedTray.Cols}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3" Height="46" CornerRadius="8" BorderThickness="1"
                                            MouseLeftButtonDown="TrayCell_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F2F2F7" />
                                                <Setter Property="BorderBrush" Value="#C7C7CC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Occupied}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Product}" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <!-- 格子属性 -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="料盘格参数" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,8,0,4" Text="标签" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.Label, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="行" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.Row, FallbackValue=0}" IsReadOnly="True" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="列" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.Col, FallbackValue=0}" IsReadOnly="True" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="占用" />
                        <CheckBox IsChecked="{Binding SelectedTrayCell.Occupied}" Content="已占用" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="料号" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.Product, FallbackValue=''}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="高度" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.Height, StringFormat={}{0:F2}, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="0,12,0,4" Text="状态" />
                        <TextBox Style="{StaticResource AppleTextField}" Text="{Binding SelectedTrayCell.State, FallbackValue=''}" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
