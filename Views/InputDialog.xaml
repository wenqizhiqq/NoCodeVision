<Window x:Class="NoCodeVision.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" Height="180" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">
    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Prompt, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10" />
            <TextBox Grid.Row="1" Style="{StaticResource AppleTextField}" Text="{Binding Answer, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,16" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AppleBtnSecondary}" Content="取消" Click="Cancel_Click" />
                <Button Style="{StaticResource AppleBtn}" Content="确定" Click="OK_Click" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
