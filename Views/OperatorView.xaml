<UserControl x:Class="NoCodeVision.Views.OperatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">
<!-- 温启志：18719361399  混淆: 温h启b志n：y1a8g7b1m9e3y6i1g3b9o9 -->


    <UserControl.Resources>
        <DataTemplate x:Key="TaskItemTemplate">
            <DockPanel LastChildFill="True">
                <ctrl:AppleIconTile Glyph="📦" TileSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="OK">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result}" Value="NG">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Result}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" />
            </DockPanel>
        </DataTemplate>

        <!-- ===== 监控卡片（紧凑网格单元） ===== -->
        <Style x:Key="MonitorCard" TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
            <Setter Property="Margin" Value="7" />
        </Style>

        <Style x:Key="MonStatusPill" TargetType="Border" BasedOn="{StaticResource AppleStatusPill}">
            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Padding" Value="8,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="运行中">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="已停止">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="运行中">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="通过">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="失败">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- ===== 监控卡片模板（网格与重点模式共用） ===== -->
        <DataTemplate x:Key="MonitorCardTemplate">
            <Border Style="{StaticResource MonitorCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 行 0：通道名 + 状态 -->
                    <DockPanel Grid.Row="0" Margin="6,6,6,2" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource AppleLabel}"
                                   FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border DockPanel.Dock="Right" Style="{StaticResource MonStatusPill}">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource MonStatusText}" />
                        </Border>
                    </DockPanel>

                    <!-- 行 1：图像预览 -->
                    <Border Grid.Row="1" Margin="6,2,6,4" Background="{StaticResource PreviewBgBrush}" CornerRadius="8"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid>
                            <Image Source="{Binding LastImage, Mode=OneWay}" Stretch="Uniform" IsHitTestVisible="False">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"
                                    Background="#1C1C22" Padding="10,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📷" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CameraId}" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="6"
                                    Background="#1A2332" Padding="10,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding LastImage}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding IsRunning}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="● 采集中" Foreground="{StaticResource AccentBrush}" FontSize="11"
                                               HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding FrameCount, StringFormat='{}{0} 帧'}" Foreground="#8E8E93" FontSize="9"
                                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 行 2：三列指标 -->
                    <Grid Grid.Row="2" Margin="6,2,6,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MatchScore, StringFormat={}{0:F2}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="匹配" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DefectCount}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="缺陷" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CycleTime, StringFormat={}{0:F0}}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="ms" FontSize="9" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== 重点模式缩略图（点击切换主画面） ===== -->
        <DataTemplate x:Key="MonitorThumbTemplate">
            <Button Command="{Binding DataContext.SwitchMainCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" Background="Transparent" Padding="4" Cursor="Hand">
                <Border Style="{StaticResource MonitorCard}" Margin="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="120" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="6,6,6,2" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{StaticResource AppleLabel}"
                                       FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border DockPanel.Dock="Right" Style="{StaticResource MonStatusPill}">
                                <TextBlock Text="{Binding Status}" Style="{StaticResource MonStatusText}" />
                            </Border>
                        </DockPanel>
                        <Border Grid.Row="1" Margin="6,2,6,4" Background="{StaticResource PreviewBgBrush}" CornerRadius="8">
                            <Image Source="{Binding LastImage, Mode=OneWay}" Stretch="Uniform" IsHitTestVisible="False">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Border>
                    </Grid>
                </Border>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMain}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧单列：生产统计 + 操作员状态 + 机台运行控制（紧凑，无滚动） ===== -->
        <StackPanel Grid.Column="0" Margin="0,2,0,8">

                <!-- 实时 UPH 大卡片 -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="实时 UPH" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UPH, StringFormat='{}{0:F0}'}" FontSize="38" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text=" 件/小时" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding RunDurationText, StringFormat='运行 {0}'}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 产量指标 -->
                <Border Style="{StaticResource AppleGroupCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="产量统计" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Total}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="总产量" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Ok}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="良品" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Ng}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="不良" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="良率" Style="{StaticResource AppleSubLabel}"
                                           Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding YieldText}" Style="{StaticResource AppleLabel}"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>


                <TextBlock Style="{StaticResource iOSTitle}" Text="操作员" />

                <!-- 检测状态 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="检测状态" />
                        <StackPanel Orientation="Horizontal" Margin="14,4,14,12">
                            <Ellipse Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,18,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DisabledBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="无代码视觉检测 · 一键启停" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="14,0,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Total}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="总数" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="6,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Ok}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="合格" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Ng}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="不合格" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="良率" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding YieldText}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 机台运行控制 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel Margin="14,12">
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="机台运行控制" />

                        <DockPanel Style="{StaticResource AppleRow}" Margin="0,4,0,8">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding StateText}" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Text="{Binding LastResult}" />
                        </DockPanel>

                        <Border CornerRadius="8" Background="{StaticResource DangerSoftBrush}"
                                Padding="10,8" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                       Text="⛔ 急停已触发：机台已锁停，请排除故障后点「复位」恢复" />
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,6,8" Height="46"
                                    Content="{Binding RunButtonText}" Command="{Binding RunCmd}"
                                    Style="{StaticResource AppleBigButton}" />
                            <Button Grid.Row="0" Grid.Column="1" Margin="6,0,6,8" Height="46"
                                    Content="暂停" Command="{Binding PauseCmd}"
                                    Style="{StaticResource AppleBigButton}" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="6,0,0,8" Height="46"
                                    Content="停止" Command="{Binding StopCmd}"
                                    Style="{StaticResource AppleBigButtonDanger}" />

                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,6,0" Height="46"
                                    Content="急停" Command="{Binding EmergencyStopCmd}"
                                    Style="{StaticResource AppleBigButtonDanger}" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" Height="46"
                                    Content="复位" Command="{Binding ResetCmd}"
                                    Style="{StaticResource AppleBtnSecondary}" />
                        </Grid>

                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="0,10,0,4" Text="机台通信日志" />
                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding MachineLog}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

        </StackPanel>

        <!-- ===== 右侧：多通道视觉监控（1×2 / 2×3 / 3×4 选择） ===== -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部：标题 + 布局选择 + 全局启停 -->
            <Border Grid.Row="0" Style="{StaticResource AppleGroupCard}" Padding="12,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📡" FontSize="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="视觉监控" Style="{StaticResource iOSTitle}" FontSize="15" VerticalAlignment="Center" />

                    <!-- 模式切换：网格平铺 / 重点(1大+多小) -->
                    <Border Background="{StaticResource SegTrackBrush}" CornerRadius="8" Padding="3" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="网格" Command="{Binding GridModeCmd}" MinWidth="48" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Grid">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="重点" Command="{Binding SpotlightModeCmd}" MinWidth="48" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mode}" Value="Spotlight">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 网格密度选择（仅网格模式显示） -->
                    <Border x:Name="LayoutSegTrack" Background="{StaticResource SegTrackBrush}" CornerRadius="8" Padding="3" Margin="8,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Spotlight">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="自适应" Command="{Binding AutoFitCmd}" MinWidth="56" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoFit}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="1×2" Command="{Binding Layout12Cmd}" MinWidth="44" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAutoFit}" Value="False" />
                                                    <Condition Binding="{Binding LayoutCols}" Value="2" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="2×3" Command="{Binding Layout23Cmd}" MinWidth="44" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAutoFit}" Value="False" />
                                                    <Condition Binding="{Binding LayoutCols}" Value="3" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="3×4" Command="{Binding Layout34Cmd}" MinWidth="44" Padding="8,4" FontSize="11">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegButton}">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAutoFit}" Value="False" />
                                                    <Condition Binding="{Binding LayoutCols}" Value="4" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                                <Setter Property="Effect" Value="{StaticResource PillShadow}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 相机网格（网格模式）：自适应填满、全部显示、无滚动条 -->
            <ItemsControl x:Name="GridModePanel" Grid.Row="1" ItemsSource="{Binding Channels}"
                          ItemTemplate="{StaticResource MonitorCardTemplate}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Spotlight">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding LayoutRows}" Columns="{Binding LayoutCols}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- 重点模式：1 大画面 + 缩略图，点击缩略图切换主画面 -->
            <Grid x:Name="SpotlightPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Spotlight">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 大画面 -->
                <Border Grid.Row="0" Margin="0,0,0,8">
                    <ContentControl Content="{Binding MainChannel}" ContentTemplate="{StaticResource MonitorCardTemplate}" />
                </Border>

                <!-- 缩略图条 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" MaxHeight="210">
                    <ItemsControl ItemsSource="{Binding Channels}" ItemTemplate="{StaticResource MonitorThumbTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
  <!-- 作者：温·启·志 编写 ▢ 联系 wx:187-1936-1399 -->
</UserControl>
