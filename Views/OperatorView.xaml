<UserControl x:Class="NoCodeVision.Views.OperatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="TaskItemTemplate">
            <DockPanel LastChildFill="True">
                <ctrl:AppleIconTile Glyph="📦" TileSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result}" Value="OK">
                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Result}" Value="NG">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Result}" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ctrl:AppleMasterList Grid.Column="0" Header="检测批次" HeaderIcon="📦"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AddCommand="{Binding AddCmd}"
                              DeleteCommand="{Binding DeleteCmd}"
                              ItemTemplate="{StaticResource TaskItemTemplate}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,8">

                <TextBlock Style="{StaticResource iOSTitle}" Text="操作员" />

                <!-- 检测状态 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="检测状态" />
                        <StackPanel Orientation="Horizontal" Margin="14,4,14,12">
                            <Ellipse Width="64" Height="64" VerticalAlignment="Center" Margin="0,0,18,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource DisabledBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="无代码视觉检测 · 一键启停" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="14,0,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Total}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="总数" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="6,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Ok}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="合格" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource HoverBrush}" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Ng}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="不合格" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="良率" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding YieldText}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 机台运行控制 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel Margin="14,12">
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="机台运行控制" />

                        <!-- 运行状态指示 -->
                        <DockPanel Style="{StaticResource AppleRow}" Margin="0,4,0,8">
                            <Ellipse Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding StateText}" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Text="{Binding LastResult}" />
                        </DockPanel>

                        <!-- 急停报警横幅 -->
                        <Border CornerRadius="8" Background="{StaticResource DangerSoftBrush}"
                                Padding="10,8" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFaulted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                       Text="⛔ 急停已触发：机台已锁停，请排除故障后点「复位」恢复" />
                        </Border>

                        <!-- 五个真实按钮：运行/暂停/停止/急停/复位 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Margin="0,0,6,8" Height="46"
                                    Content="{Binding RunButtonText}" Command="{Binding RunAllFlowsCmd}"
                                    Style="{StaticResource AppleBigButton}" />
                            <Button Grid.Row="0" Grid.Column="1" Margin="6,0,6,8" Height="46"
                                    Content="暂停" Command="{Binding PauseCmd}"
                                    Style="{StaticResource AppleBigButton}" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="6,0,0,8" Height="46"
                                    Content="停止" Command="{Binding StopAllFlowsCmd}"
                                    Style="{StaticResource AppleBigButtonDanger}" />

                            <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,6,0" Height="46"
                                    Content="急停" Command="{Binding EmergencyStopCmd}"
                                    Style="{StaticResource AppleBigButtonDanger}" />
                            <Button Grid.Row="1" Grid.Column="2" Margin="6,0,0,0" Height="46"
                                    Content="复位" Command="{Binding ResetCmd}"
                                    Style="{StaticResource AppleBtnSecondary}" />
                        </Grid>

                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="0,10,0,4" Text="机台通信日志" />
                        <Border Background="{StaticResource CanvasBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <TextBlock Style="{StaticResource AppleSubLabel}" Text="{Binding MachineLog}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
