<UserControl x:Class="NoCodeVision.Views.VisionToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：工具与操作 -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Style="{StaticResource iOSTitle}" Text="视觉工具" Margin="2,0,0,10" />
            <Border Style="{StaticResource AppleGroupCard}" Padding="14">
                <StackPanel>
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="工具" />
                    <ListBox ItemsSource="{Binding ToolModes}" SelectedItem="{Binding SelectedTool}"
                             Style="{StaticResource ApplePillList}" Margin="0,4,0,10" />

                    <Button Style="{StaticResource AppleBtn}" Content="加载图片" Command="{Binding LoadImageCmd}" />
                    <Button Style="{StaticResource AppleBtn}" Content="运行检测" Command="{Binding RunCmd}" Margin="0,8,0,0" />
                    <Button Style="{StaticResource AppleBtnSecondary}" Content="清空结果" Command="{Binding ClearCmd}" Margin="0,8,0,0" />

                    <Rectangle Style="{StaticResource AppleDivider}" Margin="0,12" />
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 中间：图像 + ROI -->
        <Grid Grid.Column="1" Margin="4,0">
            <ctrl:RoiImageView x:Name="RoiImg"
                               SourceImage="{Binding DisplayImage, Mode=OneWay}"
                               RoiX="{Binding RoiX, Mode=TwoWay}"
                               RoiY="{Binding RoiY, Mode=TwoWay}"
                               RoiW="{Binding RoiW, Mode=TwoWay}"
                               RoiH="{Binding RoiH, Mode=TwoWay}"
                               Overlays="{Binding Overlays, Mode=OneWay}" />
        </Grid>

        <!-- 右侧：参数 + 结果 -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 匹配参数 -->
                <Border Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="匹配参数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="角度起点" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="-180" Maximum="360" Value="{Binding AngleStart}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding AngleStart, StringFormat={}{0:F0}}" Width="50" />
                                <TextBlock Style="{StaticResource AppleUnit}" Text="°" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="角度终点" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="-180" Maximum="360" Value="{Binding AngleEnd}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding AngleEnd, StringFormat={}{0:F0}}" Width="50" />
                                <TextBlock Style="{StaticResource AppleUnit}" Text="°" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="角度步长" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0.1" Maximum="10" Value="{Binding AngleStep}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding AngleStep, StringFormat={}{0:F1}}" Width="50" />
                                <TextBlock Style="{StaticResource AppleUnit}" Text="°" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="NCC 阈值" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0.3" Maximum="1" Value="{Binding NccThreshold}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding NccThreshold, StringFormat={}{0:F2}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="金字塔层数" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="5" Value="{Binding PyramidLevels}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding PyramidLevels, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="多尺度范围" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="0.6" Value="{Binding ScaleRange}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding ScaleRange, StringFormat={}{0:F2}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="最大结果数" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="200" Value="{Binding TopN}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding TopN, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}" LastChildFill="True">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="密集模式" />
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource AppleToggle}" IsChecked="{Binding DenseMode}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 缺陷参数 -->
                <Border x:Name="DefectCard" Padding="14" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTool}" Value="缺陷检测">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷参数" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="差异阈值" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding DiffThreshold, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding DiffThreshold, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="最小面积占比" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0.001" Maximum="0.05" Value="{Binding MinAreaFrac, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding MinAreaFrac, StringFormat={}{0:F3}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="全局亮度阈值" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding GlobalBrightnessThresh, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding GlobalBrightnessThresh, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘容差" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="30" Value="{Binding EdgeTolerance, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding EdgeTolerance, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="边缘梯度" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="1" Maximum="254" Value="{Binding EdgeGradThresh, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding EdgeGradThresh, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="腐蚀核" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="15" Value="{Binding ErodeSize, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding ErodeSize, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="膨胀核" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="200">
                                <Slider Minimum="0" Maximum="15" Value="{Binding DilateSize, UpdateSourceTrigger=PropertyChanged}" Width="130" VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource AppleTextFieldInline}" Text="{Binding DilateSize, StringFormat={}{0:F0}}" Width="50" />
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="重置参数"
                                Command="{Binding ResetDefectCmd}" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Padding="16,6" />
                    </StackPanel>
                </Border>

                <!-- 匹配结果 -->
                <Border Style="{StaticResource AppleGroupCard}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="匹配结果" />
                        <ListBox ItemsSource="{Binding MatchResults}" Style="{StaticResource AppleListBox}" MaxHeight="220" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="2,4">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" FontWeight="SemiBold"
                                                   Text="{Binding Index, StringFormat='#{0}'}" />
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource AppleSubLabel}" Foreground="{StaticResource SuccessBrush}"
                                                   Text="{Binding Score, StringFormat='分 {0:F3}'}" />
                                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="10,0,0,0"
                                                   Text="{Binding CenterX, StringFormat='X\{0:F0\}'}" />
                                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="8,0,0,0"
                                                   Text="{Binding CenterY, StringFormat='Y\{0:F0\}'}" />
                                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="8,0,0,0"
                                                   Text="{Binding Angle, StringFormat='∠\{0:F1\}°'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 缺陷结果 -->
                <Border x:Name="DefectResultCard" Padding="14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource AppleGroupCard}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTool}" Value="缺陷检测">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="缺陷结果" />
                        <TextBlock Text="{Binding DefectSummaryText}" Margin="0,2,0,0" Foreground="#FF3B30" FontSize="12" />
                        <ListBox ItemsSource="{Binding DefectResults}" Style="{StaticResource AppleListBox}" MaxHeight="220" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="2,4">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource AppleLabel}" FontWeight="SemiBold"
                                                   Text="{Binding Type}" Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource AppleSubLabel}" Foreground="{StaticResource WarningBrush}"
                                                   Text="{Binding Score, StringFormat='严重度 {0:F1}'}" />
                                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="10,0,0,0"
                                                   Text="{Binding ImgCx, StringFormat='X\{0:F0\}'}" />
                                        <TextBlock Style="{StaticResource AppleSubLabel}" Margin="8,0,0,0"
                                                   Text="{Binding ImgCy, StringFormat='Y\{0:F0\}'}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
