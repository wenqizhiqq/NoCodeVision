<UserControl x:Class="NoCodeVision.Views.Controls.RoiImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Border Background="{StaticResource PreviewBgBrush}" CornerRadius="12" ClipToBounds="True">
        <Grid x:Name="Root">
            <!-- 像素画布：尺寸 = 图像像素尺寸；整体用 LayoutTransform 缩放以适配显示区。
                 图像、ROI、叠加框都在此坐标系（图像像素）绘制，缩放由 LayoutTransform 统一处理，彻底消除 letterbox 偏移。 -->
            <Canvas x:Name="PixelCanvas" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent"
                    MouseDown="OnMouseDown" MouseMove="OnMouseMove"
                    MouseUp="OnMouseUp" MouseWheel="OnMouseWheel">
                <Canvas.LayoutTransform>
                    <ScaleTransform x:Name="PixelScale" ScaleX="1" ScaleY="1" />
                </Canvas.LayoutTransform>
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="PixelPan" X="0" Y="0" />
                </Canvas.RenderTransform>
                <Image x:Name="Img" Stretch="None" />
                <Image x:Name="DefectLayer" Stretch="None" IsHitTestVisible="False" />
                <Canvas x:Name="Layer" IsHitTestVisible="False">
                    <Rectangle x:Name="RoiRect" Stroke="#007AFF" StrokeThickness="2" Fill="#007AFF22"
                               Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Htl" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Htr" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Hbl" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Hbr" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                </Canvas>
            </Canvas>

            <!-- ROI 坐标提示 -->
            <Border x:Name="RoiTip" Background="#1C1C22" CornerRadius="6" Padding="8,4" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                <TextBlock x:Name="RoiTipText" Foreground="#E5E5EA" FontSize="11" />
            </Border>

            <!-- 占位提示 -->
            <TextBlock x:Name="Placeholder" Text="点击「加载图片」选择源图像" Foreground="#8E8E93" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- 右下角：自适应/复位视图图标按钮 -->
            <Button x:Name="FitViewBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                    Width="30" Height="30" Cursor="Hand" ToolTip="复位视图（自适应）"
                    Click="OnFitViewClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#1C1C22" Opacity="0.82" CornerRadius="15">
                                        <Path Data="M4,4 L4,10 M4,4 L10,4 M14,4 L20,4 M20,4 L20,10 M4,20 L4,14 M4,20 L10,20 M20,20 L20,14 M20,20 L14,20"
                                              Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="bd" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
