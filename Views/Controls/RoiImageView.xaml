<UserControl x:Class="NoCodeVision.Views.Controls.RoiImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
<!-- 温启志：18719361399  混淆: 温k启v志y：o1q8e7f1z9b3i6b1p3w9o9 -->




    <UserControl.Resources>
        <Style x:Key="MeasureModeBtn" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PreviewBgBrush}" CornerRadius="12" ClipToBounds="True">
        <Grid x:Name="Root" Background="Transparent">
            <!-- 像素画布：尺寸 = 图像像素尺寸；整体用 RenderTransform 缩放/平移以适配显示区。
                 用 RenderTransform 而不是 LayoutTransform：后者在布局阶段会被父容器重新摆放，
                 拖动平移经常"拖不动"或一松手就弹回原位。 -->
            <Canvas x:Name="PixelCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="Transparent"
                    MouseDown="OnMouseDown" MouseMove="OnMouseMove"
                    MouseUp="OnMouseUp">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PixelScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PixelTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Image x:Name="Img" Stretch="Fill" />
                <Image x:Name="DefectLayer" Stretch="Fill" IsHitTestVisible="False" />
                <Canvas x:Name="Layer" IsHitTestVisible="False">
                    <Rectangle x:Name="RoiRect" Stroke="#007AFF" StrokeThickness="2" Fill="#007AFF22"
                               Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Htl" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Htr" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Hbl" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="Hbr" Width="9" Height="9" Fill="White" Stroke="#007AFF" StrokeThickness="2" Visibility="Collapsed" RadiusX="2" RadiusY="2" />
                    <Ellipse x:Name="Hrot" Width="12" Height="12" Fill="#30D158" Stroke="White" StrokeThickness="2" Visibility="Collapsed" Cursor="Cross" MouseDown="OnRotateHandleDown" />
                </Canvas>
                <Canvas x:Name="MeasureLayer" IsHitTestVisible="False" />
            </Canvas>

            <!-- ROI 坐标提示 -->
            <Border x:Name="RoiTip" Background="#1C1C22" CornerRadius="6" Padding="8,4" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                <TextBlock x:Name="RoiTipText" Foreground="#E5E5EA" FontSize="11" />
            </Border>

            <!-- 左上角：交互模式切换（框选 / 线段 / 圆） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <Button x:Name="BtnModeRoi" Content="框选" Tag="Roi" Style="{StaticResource MeasureModeBtn}" Background="#1C1C22" Click="OnModeClick" />
                <Button x:Name="BtnModeLine" Content="线段" Tag="Line" Style="{StaticResource MeasureModeBtn}" Background="#1C1C22" Click="OnModeClick" />
                <Button x:Name="BtnModeCircle" Content="圆" Tag="Circle" Style="{StaticResource MeasureModeBtn}" Background="#1C1C22" Click="OnModeClick" />
                <Button x:Name="BtnModePoint" Content="点" Tag="Point" Style="{StaticResource MeasureModeBtn}" Background="#1C1C22" Click="OnModeClick" />
                <Button x:Name="BtnModeRot" Content="旋转矩形" Tag="RotatedRect" Style="{StaticResource MeasureModeBtn}" Background="#1C1C22" Click="OnModeClick" />
            </StackPanel>

            <!-- 占位提示 -->
            <TextBlock x:Name="Placeholder" Text="点击「加载图片」选择源图像" Foreground="#8E8E93" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- 右下角：自适应/复位视图图标按钮 -->
            <Button x:Name="FitViewBtn" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                    Width="30" Height="30" Cursor="Hand" ToolTip="复位视图（自适应）"
                    Click="OnFitViewClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#1C1C22" Opacity="0.82" CornerRadius="15">
                                        <Path Data="M4,4 L4,10 M4,4 L10,4 M14,4 L20,4 M20,4 L20,10 M4,20 L4,14 M4,20 L10,20 M20,20 L20,14 M20,20 L14,20"
                                              Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="16" Height="16" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="bd" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 左下角：鼠标操作提示 -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                    Background="#1C1C22" Opacity="0.82" CornerRadius="8" Padding="8,5">
                <StackPanel>
                    <TextBlock Text="左键：绘制（框选 / 线段 / 圆 / 点 / 旋转矩形）" Foreground="White" FontSize="11" />
                    <TextBlock Text="旋转矩形：先拖出矩形，再拖绿色手柄旋转" Foreground="White" FontSize="11" />
                    <TextBlock Text="中键拖拽：平移" Foreground="White" FontSize="11" />
                    <TextBlock Text="滚轮：以光标为中心缩放" Foreground="White" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
