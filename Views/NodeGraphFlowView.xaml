<UserControl x:Class="NoCodeVision.Views.NodeGraphFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
             Loaded="OnViewLoaded">
<!-- 温启志：18719361399  节点图流程编辑器：左侧算子拖拽 → 中间连线成图 → 右侧改参数 -->

    <UserControl.Resources>

        <!-- 输入端口：把画布上算好的锚点回写给 VM，连线才有坐标 -->
        <Style TargetType="{x:Type nodify:NodeInput}" BasedOn="{StaticResource {x:Type nodify:NodeInput}}">
            <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="IsConnected" Value="{Binding IsConnected}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style TargetType="{x:Type nodify:NodeOutput}" BasedOn="{StaticResource {x:Type nodify:NodeOutput}}">
            <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="IsConnected" Value="{Binding IsConnected}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="真">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="假">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 正在拉出的临时连线 -->
        <Style TargetType="{x:Type nodify:PendingConnection}" BasedOn="{StaticResource {x:Type nodify:PendingConnection}}">
            <Setter Property="CompletedCommand" Value="{Binding Graph.CreateLinkCmd}" />
            <Setter Property="Source" Value="{Binding Source, Mode=OneWayToSource}" />
            <Setter Property="Target" Value="{Binding PreviewTarget, Mode=OneWayToSource}" />
            <Setter Property="PreviewTarget" Value="{Binding PreviewTarget, Mode=OneWayToSource}" />
            <Setter Property="Direction" Value="Forward" />
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
        </Style>

        <!-- 已建立的连线：右键可删除 -->
        <DataTemplate x:Key="NodeLinkTemplate">
            <nodify:Connection Source="{Binding FromPort.Anchor}"
                               Target="{Binding To.InputPort.Anchor}"
                               Direction="Forward"
                               Spacing="26"
                               SourceOffset="10,10"
                               TargetOffset="10,10"
                               SourceOffsetMode="Edge"
                               TargetOffsetMode="Edge"
                               ArrowEnds="End"
                               Stroke="{StaticResource AccentBrush}"
                               StrokeThickness="2"
                               OutlineBrush="{StaticResource AccentSoftBrush}"
                               OutlineThickness="7">
                <nodify:Connection.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除连线" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </nodify:Connection.ContextMenu>
            </nodify:Connection>
        </DataTemplate>

        <!-- 节点分类配色：看图=蓝 / 判断=橙 / 运动=绿 / 输出=紫 / 其它=灰 -->
        <SolidColorBrush x:Key="NodeVisionBg" Color="#EAF3FF" />
        <SolidColorBrush x:Key="NodeVisionLine" Color="#0A84FF" />
        <SolidColorBrush x:Key="NodeLogicBg" Color="#FFF4E5" />
        <SolidColorBrush x:Key="NodeLogicLine" Color="#FF9F0A" />
        <SolidColorBrush x:Key="NodeMotionBg" Color="#E9F9EF" />
        <SolidColorBrush x:Key="NodeMotionLine" Color="#34C759" />
        <SolidColorBrush x:Key="NodeOutputBg" Color="#F3ECFF" />
        <SolidColorBrush x:Key="NodeOutputLine" Color="#AF52DE" />
        <SolidColorBrush x:Key="NodeOtherBg" Color="#F2F2F7" />
        <SolidColorBrush x:Key="NodeOtherLine" Color="#8E8E93" />
        <SolidColorBrush x:Key="NodeLocateBg" Color="#E6FBFF" />
        <SolidColorBrush x:Key="NodeLocateLine" Color="#00A8C0" />
        <SolidColorBrush x:Key="NodeMeasureBg" Color="#FFF9E0" />
        <SolidColorBrush x:Key="NodeMeasureLine" Color="#B98900" />
        <SolidColorBrush x:Key="NodeColorBg" Color="#FFEBF3" />
        <SolidColorBrush x:Key="NodeColorLine" Color="#E0356B" />
        <SolidColorBrush x:Key="NodeCalibBg" Color="#EEF2F7" />
        <SolidColorBrush x:Key="NodeCalibLine" Color="#5B7C99" />
        <SolidColorBrush x:Key="NodeSaveBg" Color="#F1F5F2" />
        <SolidColorBrush x:Key="NodeSaveLine" Color="#5E8C6A" />
        <SolidColorBrush x:Key="NodeCalcBg" Color="#F0F0FF" />
        <SolidColorBrush x:Key="NodeCalcLine" Color="#5B5BD6" />
        <SolidColorBrush x:Key="NodeCodeBg" Color="#E8FFF6" />
        <SolidColorBrush x:Key="NodeCodeLine" Color="#00A870" />
        <SolidColorBrush x:Key="NodeCommBg" Color="#FFF0F0" />
        <SolidColorBrush x:Key="NodeCommLine" Color="#D64545" />

        <!-- 算子节点：图标 + 序号·功能，页脚=步骤名/运行状态；左入右出（判断类出「真/假」两个口） -->
        <DataTemplate x:Key="NodeItemTemplate">
            <nodify:Node Width="196"
                         Header="{Binding}"
                         Footer="{Binding Subtitle}"
                         Input="{Binding Input}"
                         Output="{Binding Outputs}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         FooterBrush="{StaticResource CanvasBrush}">
                <nodify:Node.Style>
                    <Style TargetType="{x:Type nodify:Node}" BasedOn="{StaticResource {x:Type nodify:Node}}">
                        <Setter Property="HeaderBrush" Value="{StaticResource NodeOtherBg}" />
                        <Setter Property="BorderBrush" Value="{StaticResource NodeOtherLine}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Vision">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeVisionBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeVisionLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Logic">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeLogicBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeLogicLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Motion">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeMotionBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeMotionLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Output">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeOutputBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeOutputLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Locate">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeLocateBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeLocateLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Measure">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeMeasureBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeMeasureLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Color">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeColorBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeColorLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Calib">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeCalibBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeCalibLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Save">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeSaveBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeSaveLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Calc">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeCalcBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeCalcLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Code">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeCodeBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeCodeLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding GroupKey}" Value="Comm">
                                <Setter Property="HeaderBrush" Value="{StaticResource NodeCommBg}" />
                                <Setter Property="BorderBrush" Value="{StaticResource NodeCommLine}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:Node.Style>
                <nodify:Node.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,0">
                            <ctrl:AppleIconTile Glyph="{Binding Glyph}" TileSize="20" />
                            <TextBlock Text="{Binding Title}" Margin="7,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type nodify:Node}}, Path=BorderBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </nodify:Node.HeaderTemplate>
                <nodify:Node.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除该节点" Command="{Binding DeleteCommand}" />
                    </ContextMenu>
                </nodify:Node.ContextMenu>
            </nodify:Node>
        </DataTemplate>

        <!-- 左侧算子库条目：左边一条色带和画布上同类节点同色 -->
        <Style x:Key="ToolChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NodeOtherLine}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="SizeAll" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GroupKey}" Value="Vision">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeVisionLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Logic">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeLogicLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Motion">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeMotionLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Output">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeOutputLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Locate">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeLocateLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Measure">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeMeasureLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Color">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeColorLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Calib">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeCalibLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Save">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeSaveLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Calc">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeCalcLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Code">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeCodeLine}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GroupKey}" Value="Comm">
                    <Setter Property="BorderBrush" Value="{StaticResource NodeCommLine}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaletteGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,6,0,6" />
        </Style>

    </UserControl.Resources>

    <!-- 左右两条边界线：把中间工作区和「流程方案」列表、右侧属性页分开 -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0" Padding="12,0">
      <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左：算子库（按住拖到右侧画布即生成节点） -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource AppleGroupCard}" Padding="10,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource AppleSectionHeader}" Text="算子库" />
                <TextBlock DockPanel.Dock="Top"
                           Text="按住算子拖到右侧画布；从端口拉出连线决定执行顺序。"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NodeGraph.Palette}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource PaletteGroupTitle}" Text="{Binding Name}" />
                                    <ItemsControl ItemsSource="{Binding Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ToolChip}"
                                                        PreviewMouseLeftButtonDown="OnToolDown"
                                                        PreviewMouseMove="OnToolMove">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 算子库与画布之间的分隔线 -->
        <Rectangle Grid.Column="1" Grid.Row="0" Width="1" Margin="10,8" HorizontalAlignment="Center"
                   Fill="{StaticResource LineBrush}" />

        <!-- 中：节点图画布 -->
        <nodify:NodifyEditor x:Name="Editor" Grid.Column="2" Grid.Row="0"
                             AllowDrop="True"
                             Drop="OnCanvasDrop"
                             DragOver="OnCanvasDragOver"
                             Background="{StaticResource CanvasBrush}"
                             GridCellSize="1"
                             MinViewportZoom="0.4"
                             MaxViewportZoom="2"
                             ItemsSource="{Binding NodeGraph.Nodes}"
                             SelectedItems="{Binding NodeGraph.SelectedNodes}"
                             Connections="{Binding NodeGraph.Links}"
                             PendingConnection="{Binding NodeGraph.PendingConnection}"
                             DisconnectConnectorCommand="{Binding NodeGraph.DisconnectCmd}"
                             ItemTemplate="{StaticResource NodeItemTemplate}"
                             ConnectionTemplate="{StaticResource NodeLinkTemplate}">
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{Binding Location}" />
                    <Setter Property="SelectedBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="HighlightBrush" Value="{StaticResource AccentSoftBrush}" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>
        </nodify:NodifyEditor>

        <!-- 空画布引导 -->
        <Border Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Padding" Value="22,16" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NodeGraph.Nodes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="从左侧把算子拖进来" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="再用鼠标从节点右侧端口拉线到下一个节点的左侧端口：连线顺序就是运行顺序，判断/分支/循环算子有「真 / 假」两个出口。"
                           FontSize="11" TextWrapping="Wrap" MaxWidth="300" TextAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 底部运行控制条：与「流程」页工具栏复用同一套命令（节点图按连线顺序执行） -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                Style="{StaticResource AppleGroupCard}" Padding="14,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AppleBtn}" Content="▶▶ 运行" Command="{Binding RunCmd}" VerticalAlignment="Center" />
                <Button Style="{StaticResource AppleBtn}" Content="▶ 单步运行" Command="{Binding StepRunCmd}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource AppleBtn}" Content="{Binding PauseResumeText}" Command="{Binding PauseResumeCmd}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource AppleBtn}" Content="⏹ 停止" Command="{Binding StopCmd}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="12,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                </Border>
            </StackPanel>
        </Border>
      </Grid>
    </Border>
</UserControl>
