<UserControl x:Class="NoCodeVision.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:NoCodeVision.Views.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="VarItemTemplate">
            <DockPanel LastChildFill="True">
                <ctrl:AppleIconTile Glyph="🧮" TileSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,0" />
                <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                           Text="{Binding Value}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ctrl:AppleMasterList Grid.Column="0" Header="变量列表" HeaderIcon="🧮"
                              ItemsSource="{Binding Variables}"
                              SelectedItem="{Binding Selected}"
                              AddCommand="{Binding AddCmd}"
                              DeleteCommand="{Binding RemoveCmd}"
                              ItemTemplate="{StaticResource VarItemTemplate}" />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,0,8">

                <TextBlock Style="{StaticResource iOSTitle}" Text="变量" />

                <!-- 新建变量 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="新建变量" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="名称" />
                            <TextBox Style="{StaticResource AppleTextField}" MinWidth="200"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="初始值" />
                            <TextBox Style="{StaticResource AppleTextField}" MinWidth="200"
                                     Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <TextBlock Style="{StaticResource AppleLabel}" Margin="14,8,14,6" Text="类型" />
                        <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}"
                                 Style="{StaticResource ApplePillList}" Margin="10,0,10,12" />
                        <DockPanel Style="{StaticResource AppleRow}" LastChildFill="False">
                            <Button Style="{StaticResource AppleBtn}" Content="添加变量" Command="{Binding AddCmd}"
                                    DockPanel.Dock="Left" />
                            <TextBlock Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center"
                                       Text="{Binding Variables.Count, StringFormat=当前共 {0} 个变量}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 选中变量信息 -->
                <Border Style="{StaticResource AppleGroupCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource AppleSectionHeader}" Text="选中变量" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="名称" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Selected.Name}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="类型" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Selected.Type}" />
                        </DockPanel>
                        <Rectangle Style="{StaticResource AppleDivider}" />
                        <DockPanel Style="{StaticResource AppleRow}">
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="当前值" />
                            <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Selected.Value}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
