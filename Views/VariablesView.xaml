<UserControl x:Class="NoCodeVision.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,2,0,8">

            <!-- 变量列表 -->
            <Border Style="{StaticResource AppleGroupCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="变量列表" />
                    <ListBox ItemsSource="{Binding Variables}" SelectedItem="{Binding Selected}"
                             Style="{StaticResource AppleListBox}" ItemContainerStyle="{StaticResource AppleListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                    <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                                               Text="{Binding Type}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource AppleSubLabel}" DockPanel.Dock="Right"
                                               Text="{Binding Value}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                    <Button DockPanel.Dock="Right" Content="删除" Margin="8,0,0,0" Cursor="Hand"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.RemoveCmd}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AppleBtnSecondary}">
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="MinWidth" Value="60" />
                                                <Setter Property="Padding" Value="10,0" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Style="{StaticResource AppleLabel}" Text="{Binding Name}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- 新建变量 -->
            <Border Style="{StaticResource AppleGroupCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource AppleSectionHeader}" Text="新建变量" />
                    <DockPanel Style="{StaticResource AppleRow}">
                        <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="名称" />
                        <TextBox Style="{StaticResource AppleTextField}" MinWidth="200"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Rectangle Style="{StaticResource AppleDivider}" />
                    <DockPanel Style="{StaticResource AppleRow}">
                        <TextBlock Style="{StaticResource AppleLabel}" DockPanel.Dock="Left" Text="初始值" />
                        <TextBox Style="{StaticResource AppleTextField}" MinWidth="200"
                                 Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Rectangle Style="{StaticResource AppleDivider}" />
                    <TextBlock Style="{StaticResource AppleLabel}" Margin="14,8,14,6" Text="类型" />
                    <ListBox ItemsSource="{Binding Types}" SelectedItem="{Binding NewType}"
                             Style="{StaticResource ApplePillList}" Margin="10,0,10,12" />
                    <DockPanel Style="{StaticResource AppleRow}" LastChildFill="False">
                        <Button Style="{StaticResource AppleBtn}" Content="添加变量" Command="{Binding AddCmd}"
                                DockPanel.Dock="Left" />
                        <TextBlock Style="{StaticResource AppleSubLabel}" VerticalAlignment="Center"
                                   Text="{Binding Variables.Count, StringFormat=当前共 {0} 个变量}" />
                    </DockPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
