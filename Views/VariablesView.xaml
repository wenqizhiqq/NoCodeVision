  <!-- 温启志 编写 ▦ 微信 18719361399（保留署名） -->
<UserControl x:Class="NoCodeVision.Views.VariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 行内字段：圆角描边容器，用于搜索框，统一视觉 -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource iOSTitle}" Text="变量" Margin="0,0,0,12" />

        <!-- 操作卡片：添加/删除 + 搜索，统一在同一张 iOS 分组卡内 -->
        <Border Grid.Row="1" Style="{StaticResource AppleGroupCard}" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <!-- 第一行：添加/删除（左） + 搜索（右） -->
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Style="{StaticResource AppleBtn}" Content="添加" Command="{Binding AddCmd}" Padding="16,7" />
                        <Button Style="{StaticResource AppleBtnSecondary}" Content="删除" Command="{Binding RemoveCmd}" Padding="16,7" Margin="8,0,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource FieldBox}" Width="240" Margin="12,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource AppleTextField}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按名称、类型或值搜索"
                                     HorizontalAlignment="Stretch"
                                     TextAlignment="Left"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCmd}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                                    ToolTip="清除搜索"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,0"
                                    Margin="6,0,0,0"
                                    Cursor="Hand"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="14"
                                    Content="✕"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DockPanel>

            </StackPanel>
        </Border>

        <!-- 变量表格：名称 / 类型 / 值 / 备注 均可直接编辑 -->
        <Border Grid.Row="2" Style="{StaticResource AppleGroupCard}">
            <DataGrid ItemsSource="{Binding VariablesView}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource LineBrush}"
                      Background="Transparent"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      RowBackground="Transparent"
                      AlternationCount="2"
                      AlternatingRowBackground="{StaticResource HoverBrush}"
                      BorderThickness="0">
                <!-- 苹果风选中样式：浅色强调底 + 深色字，避免选中后白字看不见 -->
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightBrushKey}" Color="{Binding Source={StaticResource AccentSoftBrush}, Path=Color}" />
                    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightTextBrushKey}" Color="{Binding Source={StaticResource TextPrimaryBrush}, Path=Color}" />
                    <SolidColorBrush x:Key="{x:Static sw:SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Source={StaticResource AccentSoftBrush}, Path=Color}" />
                    <SolidColorBrush x:Key="{x:Static sw:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Source={StaticResource TextPrimaryBrush}, Path=Color}" />
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="变量名称" Width="*"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="类型" Width="100"
                                        Binding="{Binding Type, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="变量值" Width="*"
                                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="备注" Width="*"
                                        Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
