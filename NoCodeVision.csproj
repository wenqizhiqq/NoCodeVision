<Project Sdk="Microsoft.NET.Sdk">
<!-- 温启志：18719361399  混淆: 温h启x志b：e1p8a7y1o9g3d6n1v3k9m9 -->




  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NoCodeVision</AssemblyName>
    <RootNamespace>NoCodeVision</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- 沙箱专属：排除 LuaHostTest 测试宿主目录；用户干净环境保留此条 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);LuaHostTest\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.8.0.20230708" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.8.0.20230708" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="NLua" Version="1.6.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <!-- 点阵(DPM)二维码解码用：原生 zxing-cpp 的 .NET 封装，识别率明显高于托管 ZXing.Net（自带 win-x64 原生库） -->
    <PackageReference Include="ZXingCpp" Version="0.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Libs\GrayModelNative.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>GrayModelNative.dll</TargetPath>
    </Content>
    <Content Include="Libs\opencv_world480.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>opencv_world480.dll</TargetPath>
    </Content>
    <Content Include="Libs\OpenCvSharpExtern.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>OpenCvSharpExtern.dll</TargetPath>
    </Content>
  </ItemGroup>

  <!-- 迈德威视相机 SDK：优先用仓库里的 Libs（换机器不用装 SDK 也能编译运行） -->
  <ItemGroup Condition="Exists('Libs\MVCAMSDK_X64.dll')">
    <Content Include="Libs\MVCAMSDK_X64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>MVCAMSDK_X64.dll</TargetPath>
    </Content>
    <Content Include="Libs\MVImageProcess_X64.DLL">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>MVImageProcess_X64.DLL</TargetPath>
    </Content>
  </ItemGroup>

  <!-- 没有随仓库带：退而求其次，从本机装的 SDK 目录拷（装了才生效） -->
  <ItemGroup Condition="!Exists('Libs\MVCAMSDK_X64.dll') And Exists('$(MSBuildProgramFiles32)\MindVision\SDK\X64\MVCAMSDK_X64.dll')">
    <None Include="$(MSBuildProgramFiles32)\MindVision\SDK\X64\MVCAMSDK_X64.dll">
      <Link>MVCAMSDK_X64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildProgramFiles32)\MindVision\SDK\X64\MVImageProcess_X64.DLL">
      <Link>MVImageProcess_X64.DLL</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>


</Project>
