<Window x:Class="NoCodeVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoCodeVision · 无代码视觉软件"
        Width="1200" Height="780"
        MinWidth="980" MinHeight="620"
        FontFamily="{StaticResource AppleFont}"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- 顶部导航栏 -->
        <Border DockPanel.Dock="Top" Height="56"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- 左侧 Logo -->
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="N" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NoCodeVision" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0" />
                    <TextBlock Text="无代码视觉" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,2,0,0" />
                </StackPanel>

                <!-- 中间分段导航 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource SegTrackBrush}" CornerRadius="9" Padding="3">
                    <StackPanel Orientation="Horizontal" x:Name="SegPanel">
                        <Button x:Name="Nav0" Tag="0" Content="项目"   Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav1" Tag="1" Content="相机"   Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav2" Tag="2" Content="通讯"   Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav3" Tag="3" Content="变量"   Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav4" Tag="4" Content="流程"   Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav5" Tag="5" Content="工程师" Style="{StaticResource SegButton}" Click="Nav_Click" />
                        <Button x:Name="Nav6" Tag="6" Content="操作员" Style="{StaticResource SegButton}" Click="Nav_Click" />
                    </StackPanel>
                </Border>

                <!-- 右侧状态 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Border Style="{StaticResource AppleStatusPill}" Background="{StaticResource AccentSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="就绪" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <ContentControl x:Name="ContentHost" Margin="22,20" />
    </DockPanel>
</Window>
